{"default":"python","langs":{"c":{"code":["/* demo strings (equal length here; the algorithm works for any pair) */","char u[] = \"bisect\", v[] = \"secret\";","int m = 6, n = 6;","int lcs[7][7];    /* lcs[i][j] = LCS length of u[i:] and v[j:] */","","void fill_table(void) {","    for (int j = n - 1; j >= 0; j--)            /* columns right to left */","        for (int i = m - 1; i >= 0; i--) {      /* rows bottom to top */","            if (u[i] == v[j])","                lcs[i][j] = lcs[i + 1][j + 1] + 1;","            else {","                int a = lcs[i + 1][j], b = lcs[i][j + 1];","                lcs[i][j] = a >= b ? a : b;","            }","        }","}","","/* walk the filled table backwards to recover the string */","void recover(char out[]) {","    int i = m, j = n, k = lcs[0][0] - 1;","    while (i > 0 && j > 0) {","        if (u[i - 1] == v[j - 1]) {","            out[k--] = u[i - 1];","            i--; j--;","        }","        else if (lcs[i - 1][j] > lcs[i][j - 1]) i--;","        else j--;","    }","    out[lcs[0][0]] = '\\0';","}","","/* the answer: lcs[0][0] == 4 and the string is \"sect\" */"],"map":[{"lines":"1-2","time":0.0},{"lines":"7-9","time":0.0},{"lines":"10","time":0.5333},{"lines":"7-9","time":2.8667},{"lines":"12-13","time":3.4},{"lines":"7-9","time":5.4667},{"lines":"12-13","time":6.0},{"lines":"7-9","time":8.0667},{"lines":"12-13","time":8.6},{"lines":"7-9","time":10.6667},{"lines":"12-13","time":11.2},{"lines":"7-9","time":13.2667},{"lines":"12-13","time":13.8},{"lines":"7-9","time":15.8667},{"lines":"12-13","time":16.4},{"lines":"7-9","time":18.4667},{"lines":"12-13","time":19.0},{"lines":"7-9","time":21.0667},{"lines":"10","time":21.6},{"lines":"7-9","time":23.9333},{"lines":"12-13","time":24.4667},{"lines":"7-9","time":26.5333},{"lines":"12-13","time":27.0667},{"lines":"7-9","time":29.1333},{"lines":"12-13","time":29.6667},{"lines":"7-9","time":31.7333},{"lines":"12-13","time":32.2667},{"lines":"7-9","time":34.3333},{"lines":"