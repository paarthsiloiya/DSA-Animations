   else {","                int a = lcs[i + 1][j], b = lcs[i][j + 1];","                lcs[i][j] = a >= b ? a : b;","            }","        }","}","","// walk the filled table backwards to recover the string ","void recover(char out[]) {","    int i = m, j = n, k = lcs[0][0] - 1;","    while (i > 0 && j > 0) {","        if (u[i - 1] == v[j - 1]) {","            out[k--] = u[i - 1];","            i--; j--;","        }","        else if (lcs[i - 1][j] > lcs[i][j - 1]) i--;","        else j--;","    }","    out[lcs[0][0]] = '\\0';","}","","// the answer: lcs[0][0] == 4 and the string is \"sect\" "],"map":[{"lines":"1-2","time":0.0},{"lines":"7-9","time":0.0},{"lines":"10","time":0.5333},{"lines":"7-9","time":2.8667},{"lines":"12-13","time":3.4},{"lines":"7-9","time":5.4667},{"lines":"12-13","time":6.0},{"lines":"7-9","time":8.0667},{"lines":"12-13","time":8.6},{"lines":"7-9","time":10.6667},{"lines":"12-13","time":11.2},{"lines":"7-9","time":13.2667},{"lines":"12-13","time":13.8},{"lines":"7-9","time":15.8667},{"lines":"12-13","time":16.4},{"lines":"7-9","time":18.4667},{"lines":"12-13","time":19.0},{"lines":"7-9","time":21.0667},{"lines":"10","time":21.6},{"lines":"7-9","time":23.9333},{"lines":"12-13","time":24.4667},{"lines":"7-9","time":26.5333},{"lines":"12-13","time":27.0667},{"lines":"7-9","time":29.1333},{"lines":"12-13","time":29.6667},{"lines":"7-9","time":31.7333},{"lines":"12-13","time":32.2667},{"lines":"7-9","time":34.3333},{"lines":"12-13","time":34.8667},{"lines":"7-9","time":36.9333},{"lines":"12-13","time":37.4667},{"lines":"7-9","time":39.5333},{"lines":"12-13","time":40.0667},{"lines":"7-9","time":42.1333},{"lines":"12-13","time":42.6667},{"lines":"7-9","time":44.7333},{"lines":"12-13","time":45.2667},{"lines":"7-9","time":47.3333},{"lines":"12-13","time":47.8667},{"lines":"7-9","time":49.9333},{"lines":"10","time":50.4667},{"lines":"7-9","time":52.8},{"lines":"12-13","time":53.3333},{"lines":"7-9","time":55.4},{"lines":"12-13","time":55.9333},{"lines":"7-9","time":58.0},{"lines":"12-13","time":58.5333},{"lines":"7-9","time":60.6},{"lines":"12-13","time":61.1333},{"lines":"7-9","time":63.2},{"lines":"12-13","time":63.7333},{"lines":"7-9","time":65.8},{"lines":"12-13","time":66.3333},{"lines":"7-9","time":68.4},{"lines":"10","time":68.9333},{"lines":"7-9","time":71.2667},{"lines":"12-13","time":71.8},{"lines":"7-9","time":73.8667},{"lines":"12-13","time":74.4},{"lines":"7-9","time":76.4667},{"lines":"12-13","time":77.0},{"lines":"7-9","time":79.0667},{"lines":"12-13","time":79.6},{"lines":"7-9","time":81.6667},{"lines":"12-13","time":82.2},{"lines":"7-9","time":84.2667},{"lines":"12-13","time":84.8},{"lines":"7-9","time":86.8667},{"lines":"10","time":87.4},{"lines":"7-9","time":89.7333},{"lines":"12-13","time":90.2667},{"lines":"7-9","time":92.3333},{"lines":"12-13","time":92.8667},{"lines":"18-27","time":95.9333},{"lines":"22-24","time":97.1333},{"lines":"32","time":100.0667},{"lines":"32","time":102.1333}]},"java":{"code":["// demo strings (equal length here; the algorithm works for any pair)","String u = \"bisect\", v = \"secret\";","int m = 6, n = 6;","int[][] lcs = new int[7][7];   // lcs[i][j] = LCS length of u[i:] and v[j:]","","void fillTable() {","    for (int j = n - 1; j >= 0; j--)            // columns right to left","        for (int i = m - 1; i >= 0; i--) {      // rows bottom to top","            if (u.charAt(i) == v.charAt(j))","                lcs[i][j] = lcs[i + 1][j + 1] + 1;","            else","                lcs[i][j] = Math.max(lcs[i + 1][j], lcs[i][j + 1]);","        }","}","","// walk the filled table backwards to recover the string","String recover() {","    StringBuilder sb = new StringBuilder();","    int i = m, j = n;","    while (i > 0 && j > 0) {","        if (u.charAt(i - 1) == v.charAt(j - 1)) {","            sb.insert(0, u.charAt(i - 1));","            i--; j--;","        }","        else if (lcs[i - 1][j] > lcs[i][j - 1]) i--;","        else j--;","    }","    return sb.toString();","}","","// the answer: lcs[0][0] == 4 and the string is \"sect\""],"map":[{"lines":"1-2","time":0.0},{"lines":"7-9","time":0.0},{"lines":"10","time":0.5333},{"lines":"7-9","time":2.8667},{"lines":"12","time":3.4},{"lines":"7-9","time":5.4667},{"lines":"12","time":6.0},{"lines":"7-9","time":8.0667},{"lines":"12","time":8.6},{"lines":"7-9","time":10.6667},{"lines":"12","time":11.2},{"lines":"7-9","time":13.2667},{"lines":"12","time":13.8},{"lines":"7-9","time":15.8667},{"lines":"12","time":16.4},{"lines":"7-9","time":18.4667},{"lines":"12","time":19.0},{"lines":"7-9","time":21.0667},{"lines":"10","time":21.6},{"lines":"7-9","time":23.9333},{"lines":"12","time":24.4667},{"lines":"7-9","time":26.5333},{"lines":"12","time":27.0667},{"lines":"7-9","time":29.1333},{"lines":"12","time":29.6667},{"lines":"7-9","time":31.7333},{"lines":"12","time":32.2667},{"lines":"7-9","time":34.3333},{"lines":"12","time":34.8667},{"lines":"7-9","time":36.9333},{"lines":"12","time":37.4667},{"lines":"7-9","time":39.5333},{"lines":"12","time":40.0667},{"lines":"7-9","time":42.1333},{"lines":"12","time":42.6667},{"lines":"7-9","time":44.7333},{"lines":"12","time":45.2667},{"lines":"7-9","time":47.3333},{"lines":"12","time":47.8667},{"lines":"7-9","time":49.9333},{"lines":"10","time":50.4667},{"lines":"7-9","time":52.8},{"lines":"12","time":53.3333},{"lines":"7-9","time":55.4},{"lines":"12","time":55.9333},{"lines":"7-9","time":58.0},{"lines":"12","time":58.5333},{"lines":"7-9","time":60.6},{"lines":"12","time":61.1333},{"lines":"7-9","time":63.2},{"lines":"12","time":63.7333},{"lines":"7-9","time":65.8},{"lines":"12","time":66.3333},{"lines":"7-9","time":68.4},{"lines":"10","time":68.9333},{"lines":"7-9","time":71.2667},{"lines":"12","time":71.8},{"lines":"7-9","time":73.8667},{"lines":"12","time":74.4},{"lines":"7-9","time":76.4667},{"lines":"12","time":77.0},{"lines":"7-9","time":79.0667},{"lines":"12","time":79.6},{"lines":"7-9","time":81.6667},{"lines":"12","time":82.2},{"lines":"7-9","time":84.2667},{"lines":"12","time":84.8},{"lines":"7-9","time":86.8667},{"lines":"10","time":87.4},{"lines":"7-9","time":89.7333},{"lines":"12","time":90.2667},{"lines":"7-9","time":92.3333},{"lines":"12","time":92.8667},{"lines":"16-28","time":95.9333},{"lines":"22-23","time":97.1333},{"lines":"31","time":100.0667},{"lines":"31","time":102.1333}]},"python":{"code":["u, v = \"bisect\", \"secret\"","m, n = len(u), len(v)","","# lcs[i][j] = length of the LCS of u[i:] and v[j:]","# (the table fills backwards, so the answer lands in lcs[0][0])","lcs = [[0] * (n + 1) for _ in range(m + 1)]","","for j in range(n - 1, -1, -1):          # columns right to left","    for i in range(m - 1, -1, -1):      # rows bottom to top","        if u[i] == v[j]:","            lcs[i][j] = lcs[i + 1][j + 1] + 1","        else:","            lcs[i][j] = max(lcs[i + 1][j], lcs[i][j + 1])","","answer = lcs[0][0]","","# walk the filled table backwards to recover the string","s, i, j = \"\", m, n","while i > 0 and j > 0:","    if u[i - 1] == v[j - 1]:","        s = u[i - 1] + s; i -= 1; j -= 1","    elif lcs[i - 1][j] > lcs[i][j - 1]:","        i -= 1","    else:","        j -= 1","","print(f\"LCS: \\\"{s}\\\" (Length: {answer})\")"],"map":[{"lines":"1-6","time":0.0},{"lines":"8-10","time":0.0},{"lines":"11","time":0.5333},{"lines":"8-10","time":2.8667},{"lines":"13","time":3.4},{"lines":"8-10","time":5.4667},{"lines":"13","time":6.0},{"lines":"8-10","time":8.0667},{"lines":"13","time":8.6},{"lines":"8-10","time":10.6667},{"lines":"13","time":11.2},{"lines":"8-10","time":13.2667},{"lines":"13","time":13.8},{"lines":"8-10","time":15.8667},{"lines":"13","time":16.4},{"lines":"8-10","time":18.4667},{"lines":"13","time":19.0},{"lines":"8-10","time":21.0667},{"lines":"11","time":21.6},{"lines":"8-10","time":23.9333},{"lines":"13","time":24.4667},{"lines":"8-10","time":26.5333},{"lines":"13","time":27.0667},{"lines":"8-10","time":29.1333},{"lines":"13","time":29.6667},{"lines":"8-10","time"