{"default":"python","langs":{"c":{"code":["struct Node *delete(struct Node *node, int value) {","    if (node == NULL)","        return NULL;                   /* value not in the tree */","    if (value < node->data)","        node->left = delete(node->left, value);","    else if (value > node->data)","        node->right = delete(node->right, value);","    else {                              /* found the node */","        if (node->left == NULL)         /* case: no left child */","            return node->right;","        if (node->right == NULL)       /* case: no right child */","            return node->left;","        /* two children: replace with the in-order successor */","        struct Node *s = leftmost(node->right);  /* right, then leftmost */","        node->data = s->data;","        node->right = delete(node->right, s->data);","    }","    return node;","}"],"map":[{"lines":"1","time":3.2},{"lines":"4","time":4.0},{"lines":"5","time":4.8},{"lines":"8","time":8.5333},{"lines":"9-10","time":10.8},{"lines":"1","time":15.1333},{"lines":"4","time":15.9333},{"lines":"5","time":16.7333},{"lines":"7","time":17.8667},{"lines":"8","time":19.3333},{"lines":"12","time":21.6},{"lines":"1","time":27.1333},{"lines":"4","time":27.9333},{"lines":"8","time":29.0667},{"lines":"14","time":31.3333},{"lines":"15","time":36.2667},{"lines":"16","time":38.8667},{"lines":"16","time":42.2667}]},"cpp":{"code":["Node *remove(Node *node, int value) {","    if (node == nullptr)","        return nullptr;                // value not in the tree","    if (value < node->data)","        node->left = remove(node->left, value);","    else if (value > node->data)","        node->right = remove(node->right, value);","    else {                              // found the node","        if (node->left == nullptr)      // case: no left child","            return node->right;","        if (node->right == nullptr)     // case: no right child","            return node->left;","        // two children: replace with the in-order successor","        Node *s = leftmost(node->right);  // right, then leftmost","        node->data = s->data;","        node->right = remove(node->right, s->data);","    }","    return node;","}"],"map":[{"lines":"1","time":3.2},{"lines":"4","time":4.0},{"lines":"5","time":4.8},{"lines":"8","time":8.5333},{"lines":"9-10","time":10.8},{"lines":"1","time":15.1333},{"lines":"4","time":15.9333},{"lines":"5","time":16.7333},{"lines":"7","time":17.8667},{"lines":"8","time":19.3333},{"lines":"12","time":21.6},{"lines":"1","time":27.1333},{"lines":"4","time":27.9333},{"lines":"8","time":29.0667},{"lines":"14","time":31.3333},{"lines":"15","time":36.2667},{"lines":"16","time":38.8667},{"lines":"16","time":42.2667}]},"java":{"code":["Node delete(Node node, int value) {","    if (node == null)","        return null;                   // value not in the tree","    if (value < node.data)","        node.left = delete(node.left, value);","    else if (value > node.data)","        node.right = delete(node.right, value);","    else {                              // found the node","        if (node.left == null)          // case: no left child","            return node.right;","        if (node.right == null)        // case: no right child","            return node.left;","        // two children: replace with the in-order successor","        Node s = leftmost(node.right);  // right, then leftmost","        node.data = s.data;","        node.right = delete(node.right, s.data);","    }","    return node;","}"],"map":[{"lines":"1","time":3.2},{"lines":"4","time":4.0},{"lines":"5","time":4.8},{"lines":"8","time":8.5333},{"lines":"9-10","time":10.8},{"lines":"1","time":15.1333},{"lines":"4","time":15.9333},{"lines":"5","time":16.7333},{"lines":"7","time":17.8667},{"lines":"8","time":19.3333},{"lines":"12","time":21.6},{"lines":"1","time":27.1333},{"lines":"4","time":27.9333},{"lines":"8","time":29.0667},{"lines":"14","time":31.3333},{"lines":"15","time":36.2667},{"lines":"16","time":38.8667},{"lines":"16","time":42.2667}]},"python":{"code":["def delete(node, value):","    if node is None:","        return None                    # value not in the tree","    if value < node.data:","        node.left = delete(node.left, value)","    elif value > node.data:","        node.right = delete(node.right, value)","    else:                               # found the node","        if node.left is None:           # case: no left child","            return node.right","        if node.right is None:          # case: no right child","            return node.left","        # two children: replace with the in-order successor","        successor = leftmost(node.right)   # go right, then leftmost","        node.data = successor.data","        node.right = delete(node.right, successor.data)","    return node"],"map":[{"lines":"1","time":3.2},{"lines":"4","time":4.0},{"lines":"5","time":4.8},{"lines":"8","time":8.5333},{"lines":"9-10","time":10.8},{"lines":"1","time":15.1333},{"lines":"4","time":15.9333},{"lines":"5","time":16.7333},{"lines":"7","time":17.8667},{"lines":"8","time":19.3333},{"lines":"12","time":21.6},{"lines":"1","time":27.1333},{"lines":"4","time":27.9333},{"lines":"8","time":29.0667},{"lines":"14","time":31.3333},{"lines":"15","time":36.2667},{"lines":"16","time":38.8667},{"lines":"16","time":42.2667}]}},"video":"Videos/Trees/BinarySearchTreeDeletion.webm"}
