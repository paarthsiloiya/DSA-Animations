{"default":"python","langs":{"c":{"code":["int arr[6] = {5, 2, 4, 6, 3, 1};","","/* Forward indexing: positions 0 to N-1 */","printf(\"%d\\n\", arr[0]);   /* 5 - first element */","printf(\"%d\\n\", arr[3]);   /* 6 - fourth element */","","/* Reverse indexing: C has no negative indices - */","/* emulate arr[-k] as arr[N - k] */","printf(\"%d\\n\", arr[6 - 6]);  /* 5 - first element again */","printf(\"%d\\n\", arr[6 - 1]);  /* 1 - last element */"],"map":[{"lines":"1","time":0.0},{"lines":"3","time":0.4667},{"lines":"4-5","time":1.2},{"lines":"4","time":2.2},{"lines":"7","time":4.9333},{"lines":"9-10","time":5.4667},{"lines":"9","time":6.4667},{"lines":"9","time":9.2}]},"cpp":{"code":["int arr[6] = {5, 2, 4, 6, 3, 1};","","// Forward indexing: positions 0 to N-1","std::cout << arr[0] << \"\\n\";   // 5 - first element","std::cout << arr[3] << \"\\n\";   // 6 - fourth element","","// Reverse indexing: C++ has no negative indices -","// emulate arr[-k] as arr[N - k]","std::cout << arr[6 - 6] << \"\\n\";  // 5 - first element again","std::cout << arr[6 - 1] << \"\\n\";  // 1 - last element"],"map":[{"lines":"1","time":0.0},{"lines":"3","time":0.4667},{"lines":"4-5","time":1.2},{"lines":"4","time":2.2},{"lines":"7","time":4.9333},{"lines":"9-10","time":5.4667},{"lines":"9","time":6.4667},{"lines":"9","time":9.2}]},"java":{"code":["int arr[] = {5, 2, 4, 6, 3, 1};","","// Forward indexing: positions 0 to N-1","System.out.println(arr[0]);   // 5 - first element","System.out.println(arr[3]);   // 6 - fourth element","","// Reverse indexing: Java has no negative indices -","// emulate arr[-k] as arr[N - k]","System.out.println(arr[6 - 6]);  // 5 - first element again","System.out.println(arr[6 - 1]);  // 1 - last element"],"map":[{"lines":"1","time":0.0},{"lines":"3","time":0.4667},{"lines":"4-5","time":1.2},{"lines":"4","time":2.2},{"lines":"7","time":4.9333},{"lines":"9-10","time":5.4667},{"lines":"9","time":6.4667},{"lines":"9","time":9.2}]},"python":{"code":["arr = [5, 2, 4, 6, 3, 1]","","# Forward indexing: positions 0 to N-1","print(arr[0])    # 5 - first element","print(arr[3])    # 6 - fourth element","","# Reverse indexing: positions -N to -1","print(arr[-6])   # 5 - first element again","print(arr[-1])   # 1 - last element"],"map":[{"lines":"1","time":0.0},{"lines":"3","time":0.4667},{"lines":"4-5","time":1.2},{"lines":"4","time":2.2},{"lines":"7","time":4.9333},{"lines":"8-9","time":5.4667},{"lines":"8","time":6.4667},{"lines":"8","time":9.2}]}},"video":"Videos/Arrays/Indexing.webm"}
