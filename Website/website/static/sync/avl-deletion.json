{"default":"python","langs":{"c":{"code":["struct Node *delete(struct Node *root, int key) {","    if (root == NULL)","        return root;","    if (key < root->key)","        root->left = delete(root->left, key);","    else if (key > root->key)","        root->right = delete(root->right, key);","    else {                                 /* found the node */","        if (root->left == NULL)           /* case: no left child */","            return root->right;","        if (root->right == NULL)         /* case: no right child */","            return root->left;","        struct Node *s = min_value_node(root->right);  /* successor */","        root->key = s->key;","        root->right = delete(root->right, s->key);","    }","","    root->height = 1 + max(height(root->left), height(root->right));","    int balance = height(root->left) - height(root->right);","","    if (balance > 1 && get_balance(root->left) >= 0)   /* Left-Left */","        return right_rotate(root);","    if (balance > 1 && get_balance(root->left) < 0) {  /* Left-Right */","        root->left = left_rotate(root->left);","        return right_rotate(root);","    }","    if (balance < -1 && get_balance(root->right) <= 0) /* Right-Right */","        return left_rotate(root);","    if (balance < -1 && get_balance(root->right) > 0) { /* Right-Left */","        root->right = right_rotate(root->right);","        return left_rotate(root);","    }","    return root;","}"],"map":[{"lines":"1","time":2.0},{"lines":"4","time":2.8},{"lines":"5","time":3.6},{"lines":"8","time":7.3333},{"lines":"9-10","time":9.6},{"lines":"1","time":13.6},{"lines":"4","time":14.4},{"lines":"5","time":15.2},{"lines":"7","time":16.3333},{"lines":"8","time":17.8},{"lines":"12","time":20.0667},{"lines":"1","time":24.6},{"lines":"4","time":25.4},{"lines":"8","time":26.5333},{"lines":"13","time":28.8},{"lines":"14","time":33.7333},{"lines":"15","time":37.2},{"lines":"9-10","time":37.9333},{"lines":"1","time":42.4667},{"lines":"4","time":43.2667},{"lines":"5","time":44.0667},{"lines":"7","time":45.2},{"lines":"8","time":46.6667},{"lines":"9-10","time":48.9333},{"lines":"24","time":51.5333},{"lines":"25","time":54.0667},{"lines":"25","time":61.5333}]},"cpp":{"code":["Node *remove(Node *root, int key) {","    if (root == nullptr)","        return root;","    if (key < root->key)","        root->left = remove(root->left, key);","    else if (key > root->key)","        root->right = remove(root->right, key);","    else {                                 // found the node","        if (root->left == nullptr)         // case: no left child","            return root->right;","        if (root->right == nullptr)      // case: no right child","            return root->left;","        Node *s = min_value_node(root->right);  // successor","        root->key = s->key;","        root->right = remove(root->right, s->key);","    }","","    root->height = 1 + std::max(height(root->left), height(root->right));","    int balance = height(root->left) - height(root->right);","","    if (balance > 1 && get_balance(root->left) >= 0)   // Left-Left","        return right_rotate(root);","    if (balance > 1 && get_balance(root->left) < 0) {  // Left-Right","        root->left = left_rotate(root->left);","        return right_rotate(root);","    }","    if (balance < -1 && get_balance(root->right) <= 0) // Right-Right","        return left_rotate(root);","    if (balance < -1 && get_balance(root->right) > 0) { // Right-Left","        root->right = right_rotate(root->right);","        return left_rotate(root);","    }","    return root;","}"],"map":[{"lines":"1","time":2.0},{"lines":"4","time":2.8},{"lines":"5","time":3.6},{"lines":"8","time":7.3333},{"lines":"9-10","time":9.6},{"lines":"1","time":13.6},{"lines":"4","time":14.4},{"lines":"5","time":15.2},{"lines":"7","time":16.3333},{"lines":"8","time":17.8},{"lines":"12","time":20.0667},{"lines":"1","time":24.6},{"lines":"4","time":25.4},{"lines":"8","time":26.5333},{"lines":"13","time":28.8},{"lines":"14","time":33.7333},{"lines":"15","time":37.2},{"lines":"9-10","time":37.9333},{"lines":"1","time":42.4667},{"lines":"4","time":43.2667},{"lines":"5","time":44.0667},{"lines":"7","time":45.2},{"lines":"8","time":46.6667},{"lines":"9-10","time":48.9333},{"lines":"24","time":51.5333},{"lines":"25","time":54.0667},{"lines":"25","time":61.5333}]},"java":{"code":["Node delete(Node root, int key) {","    if (root == null)","        return root;","    if (key < root.key)","        root.left = delete(root.left, key);","    else if (key > root.key)","        root.right = delete(root.right, key);","    else {                                 // found the node","        if (root.left == null)             // case: no left child","            return root.right;","        if (root.right == null)         // case: no right child","            return root.left;","        Node s = minValueNode(root.right);  // in-order successor","        root.key = s.key;","        root.right = delete(root.right, s.key);","    }","","    root.height = 1 + Math.max(height(root.left), height(root.right));","    int balance = height(root.left) - height(root.right);","","    if (balance > 1 && getBalance(root.left) >= 0)   // Left-Left","        return rightRotate(root);","    if (balance > 1 && getBalance(root.left) < 0) { // Left-Right","        root.left = leftRotate(root.left);","        return rightRotate(root);","    }","    if (balance < -1 && getBalance(root.right) <= 0) // Right-Right","        return leftRotate(root);","    if (balance < -1 && getBalance(root.right) > 0) { // Right-Left","        root.right = rightRotate(root.right);","        return leftRotate(root);","    }","    return root;","}"],"map":[{"lines":"1","time":2.0},{"lines":"4","time":2.8},{"lines":"5","time":3.6},{"lines":"8","time":7.3333},{"lines":"9-10","time":9.6},{"lines":"1","time":13.6},{"lines":"4","time":14.4},{"lines":"5","time":15.2},{"lines":"7","time":16.3333},{"lines":"8","time":17