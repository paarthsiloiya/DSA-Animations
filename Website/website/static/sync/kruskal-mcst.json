{"default":"python","langs":{"c":{"code":["/* the 16 edge copies already sorted by weight (then u, v) */","int edges[16][3] = {{4,6,5},{6,4,5},{1,2,6},{2,1,6},","                    {0,1,10},{1,0,10},{5,6,10},{6,5,10},","                    {1,4,20},{4,1,20},{4,5,50},{5,4,50},","                    {2,3,70},{3,2,70},{0,2,80},{2,0,80}};","","int component[7];                    /* label-propagation union-find */","int total = 0;","","void kruskal(void) {","    for (int v = 0; v < 7; v++) component[v] = v;","    for (int e = 0; e < 16; e++) {   /* smallest weight first */","        int u = edges[e][0], v = edges[e][1], w = edges[e][2];","        if (component[u] != component[v]) {  /* different trees -> no cycle */","            total += w;","            int old = component[u];   /* merge: one label wins */","            for (int t = 0; t < 7; t++)","                if (component[t] == old)","                    component[t] = component[v];","        }","    }","}"],"map":[{"lines":"2","time":0.0},{"lines":"7","time":9.0},{"lines":"12","time":9.8},{"lines":"14","time":10.8},{"lines":"15","time":12.0667},{"lines":"14","time":13.3333},{"lines":"15","time":14.6},{"lines":"14","time":15.8667},{"lines":"15","time":17.1333},{"lines":"14","time":18.4},{"lines":"15","time":19.6667},{"lines":"14","time":20.9333},{"lines":"15","time":22.2},{"lines":"14","time":23.4667},{"lines":"15","time":24.7333},{"lines":"16","time":27.5333},{"lines":"16","time":35.4}]},"cpp":{"code":["// the 16 edge copies already sorted by weight (then u, v) ","int edges[16][3] = {{4,6,5},{6,4,5},{1,2,6},{2,1,6},","                    {0,1,10},{1,0,10},{5,6,10},{6,5,10},","                    {1,4,20},{4,1,20},{4,5,50},{5,4,50},","                    {2,3,70},{3,2,70},{0,2,80},{2,0,80}};","","int component[7];                    // label-propagation union-find ","int total = 0;","","void kruskal(void) {","    for (int v = 0; v < 7; v++) component[v] = v;","    for (int e = 0; e < 16; e++) {   // smallest weight first ","        int u = edges[e][0], v = edges[e][1], w = edges[e][2];","        if (component[u] != component[v]) {  // different trees -> no cycle ","            total += w;","            int old = component[u];   // merge: one label wins ","            for (int t = 0; t < 7; t++)","                if (component[t] == old)","                    component[t] = component[v];","        }","    }","}"],"map":[{"lines":"2","time":0.0},{"lines":"7","time":9.0},{"lines":"12","time":9.8},{"lines":"14","time":10.8},{"lines":"15","time":12.0667},{"lines":"14","time":13.3333},{"lines":"15","time":14.6},{"lines":"14","time":15.8667},{"lines":"15","time":17.1333},{"lines":"14","time":18.4},{"lines":"15","time":19.6667},{"lines":"14","time":20.9333},{"lines":"15","time":22.2},{"lines":"14","time":23.4667},{"lines":"15","time":24.7333},{"lines":"16","time":27.5333},{"lines":"16","time":35.4}]},"java":{"code":["// the demo graph's 16 edge copies, before sorting","int[][] edges = { {0,1,10},{0,2,80},{1,0,10},{1,2,6},{1,4,20},","                  {2,0,80},{2,1,6},{2,3,70},{3,2,70},{4,1,20},","                  {4,5,50},{4,6,5},{5,4,50},{5,6,10},{6,4,5},{6,5,10} };","","int[] component = new int[7];        // label-propagation union-find","int total = 0;","","void kruskal() {","    for (int v = 0; v < 7; v++) component[v] = v;","    java.util.Arrays.sort(edges, (a, b) -> {   // by weight, then u, then v","        if (a[2] != b[2]) return Integer.compare(a[2], b[2]);","        if (a[0] != b[0]) return Integer.compare(a[0], b[0]);","        return Integer.compare(a[1], b[1]);","    });","    for (int[] e : edges) {          // smallest weight first","        int u = e[0], v = e[1], w = e[2];","        if (component[u] != component[v]) {  // different trees -> no cycle","            total += w;","            int old = component[u];   // merge: one label wins","            for (int t = 0; t < 7; t++)","                if (component[t] == old)","                    component[t] = component[v];","        }","    }","}"],"map":[{"lines":"2","time":0.0},{"lines":"6","time":9.0},{"lines":"16","time":9.8},{"lines":"18","time":10.8},{"lines":"19","time":12.0667},{"lines":"18","time":13.3333},{"lines":"19","time":14.6},{"lines":"18","time":15.8667},{"lines":"19","time":17.1333},{"lines":"18","time":18.4},{"lines":"19","time":19.6667},{"lines":"18","time":20.9333},{"lines":"19","time":22.2},{"lines":"18","time":23.4667},{"lines":"19","time":24.7333},{"lines":"20","time":27.5333},{"lines":"20","time":35.4}]},"python":{"code":["# the demo graph, edge list (undirected: stored both ways)","edges = sorted((w, u, v) for u in adj for v, w in adj[u])","","component = {v: v for v in range(7)}   # label-propagation union-find","tree, total = [], 0","","for w, u, v in edges:                   # smallest weight first","    if component[u] != component[v]:    # different trees -> no cycle","        tree.append((u, v))","        total += w","        old = component[u]              # merge: one label wins","        for t in component:","            if component[t] == old:","                component[t] = component[v]"],"map":[{"lines":"2","time":0.0},{"lines":"4","time":9.0},{"lines":"7","time":9.8},{"lines":"9","time":10.8},{"lines":"10","time":12.0667},{"lines":"9","time":13.3333},{"lines":"10","time":14.6},{"lines":"9","time":15.8667},{"lines":"10","time":17.1333},{"lines":"9","time":18.4},{"lines":"10","time":19.6667},{"lines":"9","time":20.9333},{"lines":"10","time":22.2},{"lines":"9","time":23.4667},{"lines":"10","time":24.7333},{"lines":"11","time":27.5333},{"lines":"11","time":35.4}]}},"video":"Videos/Graphs/KruskalMCST.webm"}
