":"7-8","time":43.6},{"lines":"11-12","time":44.0},{"lines":"15-16","time":46.6667},{"lines":"17-18","time":48.6667},{"lines":"7-8","time":50.4667},{"lines":"9","time":50.8667},{"lines":"7-8","time":53.2},{"lines":"9","time":53.6},{"lines":"7-8","time":55.9333},{"lines":"11-12","time":56.3333},{"lines":"7-8","time":59.0},{"lines":"9","time":59.4},{"lines":"15-16","time":61.7333},{"lines":"17-18","time":65.3333},{"lines":"29","time":67.0},{"lines":"29","time":69.0}]},"java":{"code":["// the demo: ranks given by the animation's top row","int[] values = {4, 2, 1, 6, 3, 5};     // F B E A D C","int[] temp = new int[6];","","int merge(int[] a, int[] temp, int left, int mid, int right) {","    int i = left, j = mid + 1, k = left, split = 0;","    while (i <= mid && j <= right) {","        if (a[i] <= a[j]) {","            temp[k++] = a[i++];","        } else {","            split += mid - i + 1;       // every remaining left element","            temp[k++] = a[j++];         // is inverted with a[j]","        }","    }","    while (i <= mid) temp[k++] = a[i++];","    while (j <= right) temp[k++] = a[j++];","    for (i = left; i <= right; i++) a[i] = temp[i];","    return split;","}","","int mergeCount(int[] a, int[] temp, int left, int right) {","    if (left >= right) return 0;","    int mid = (left + right) / 2;","    return mergeCount(a, temp, left, mid)","         + mergeCount(a, temp, mid + 1, right)","         + merge(a, temp, left, mid, right);","}","","// mergeCount(values, temp, 0, 5) counts 6 inversions"],"map":[{"lines":"1-2","time":0.0},{"lines":"2","time":6.0},{"lines":"23-25","time":14.8667},{"lines":"22","time":15.8667},{"lines":"7-8","time":16.9333},{"lines":"11-12","time":17.3333},{"lines":"15-16","time":20.0},{"lines":"17-18","time":22.0},{"lines":"22","time":23.2667},{"lines":"7-8","time":24.0667},{"lines":"11-12","time":24.4667},{"lines":"15-16","time":27.1333},{"lines":"17-18","time":30.7333},{"lines":"23-25","time":32.0},{"lines":"22","time":32.6667},{"lines":"7-8","time":33.7333},{"lines":"11-12","time":34.1333},{"lines":"15-16","time":36.8},{"lines":"17-18","time":38.8},{"lines":"22","time":40.0667},{"lines":"7-8","time":40.8667},{"lines":"9","time":41.2667},{"lines":"7-8","time":43.6},{"lines":"11-12","time":44.0},{"lines":"15-16","time":46.6667},{"lines":"17-18","time":48.6667},{"lines":"7-8","time":50.4667},{"lines":"9","time":50.8667},{"lines":"7-8","time":53.2},{"lines":"9","time":53.6},{"lines":"7-8","time":55.9333},{"lines":"11-12","time":56.3333},{"lines":"7-8","time":59.0},{"lines":"9","time":59.4},{"lines":"15-16","time":61.7333},{"lines":"17-18","time":65.3333},{"lines":"29","time":67.0},{"lines":"29","time":69.0}]},"python":{"code":["rank = {'E': 1, 'B': 2, 'D': 3, 'F': 4, 'C': 5, 'A': 6}","values = [rank[c] for c in \"FBEADC\"]","","def merge_count(a):","    if len(a) <= 1:","        return a, 0","    mid = len(a) // 2","    left, nleft = merge_count(a[:mid])","    right, nright = merge_count(a[mid:])","    merged, i, j, split = [], 0, 0, 0","    while i < len(left) and j < len(right):","        if left[i] <= right[j]:","            merged.append(left[i]); i += 1","        else:","            split += len(left) - i     # the remaining left elements","            merged.append(right[j]); j += 1   # are inverted with right[j]","    merged += left[i:] + right[j:]","    return merged, nleft + nright + split","","print(merge_count(values))"],"map":[{"lines":"1-2","time":0.0},{"lines":"2","time":6.0},{"lines":"7-9","time":14.8667},{"lines":"5-6","time":15.8667},{"lines":"11-12","time":16.9333},{"lines":"15-16","time":17.3333},{"lines":"17","time":20.0},{"lines":"18","time":22.0},{"lines":"5-6","time":23.2667},{"lines":"11-12","time":24.0667},{"lines":"15-16","time":24.4667},{"lines":"17","time":27.1333},{"lines":"18","time":30.7333},{"lines":"7-9","time":32.0},{"lines":"5-6","time":32.6667},{"lines":"11-12","time":33.7333},{"lines":"15-16","time":34.1333},{"lines":"17","time":36.8},{"lines":"18","time":