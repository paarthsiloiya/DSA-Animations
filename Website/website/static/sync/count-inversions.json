{"default":"python","langs":{"c":{"code":["/* the demo: ranks given by the animation's top row */","int values[6] = {4, 2, 1, 6, 3, 5};    /* F B E A D C */","int temp[6];","","int merge(int a[], int temp[], int left, int mid, int right) {","    int i = left, j = mid + 1, k = left, split = 0;","    while (i <= mid && j <= right) {","        if (a[i] <= a[j]) {","            temp[k++] = a[i++];","        } else {","            split += mid - i + 1;       /* every remaining left element */","            temp[k++] = a[j++];         /* is inverted with a[j] */","        }","    }","    while (i <= mid) temp[k++] = a[i++];","    while (j <= right) temp[k++] = a[j++];","    for (i = left; i <= right; i++) a[i] = temp[i];","    return split;","}","","int merge_count(int a[], int temp[], int left, int right) {","    if (left >= right) return 0;","    int mid = (left + right) / 2;","    return merge_count(a, temp, left, mid)","         + merge_count(a, temp, mid + 1, right)","         + merge(a, temp, left, mid, right);","}","","/* merge_count(values, temp, 0, 5) counts 6 inversions */"],"map":[{"lines":"1-2","time":0.0},{"lines":"2","time":6.0},{"lines":"23-25","time":14.8667},{"lines":"22","time":15.8667},{"lines":"7-8","time":16.9333},{"lines":"11-12","time":17.3333},{"lines":"15-16","time":20.0},{"lines":"17-18","time":22.0},{"lines":"22","time":23.2667},{"lines":"7-8","time":24.0667},{"lines":"11-12","time":24.4667},{"lines":"15-16","time":27.1333},{"lines":"17-18","time":30.7333},{"lines":"23-25","time":32.0},{"lines":"22","time":32.6667},{"lines":"7-8","time":33.7333},{"lines":"11-12","time":34.1333},{"lines":"15-16","time":36.8},{"lines":"17-18","time":38.8},{"lines":"22","time":40.0667},{"lines":"7-8","time":40.8667},{"lines":"9","time":41.2667},{"lines":"7-8","time":43.6},{"lines":"11-12","time":44.0},{"lines":"15-16","time":46.6667},{"lines":"17-18","time":48.6667},{"lines":"7-8","time":50.4667},{"lines":"9","time":50.8667},{"lines":"7-8","time":53.2},{"lines":"9"