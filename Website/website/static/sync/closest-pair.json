169, -2.615293473131186), (-3.7547670009646965, 0.7394809240540603),"," (-4.936382906556102, 0.6514070344880314), (2.2703331772136846, -2.4897916734063634),"," (0.49926446566904215, -0.8716951643261255), (-1.2240188355072914, 1.9809871962966294),"," (-5.696440550282041, -3.0940944164597317), (6.157226819003869, -1.1046817796232347),"," (-4.221033149339351, -1.4823910740160482), (-1.8914738866985337, 1.7665868020216315),"," (-4.055348082366278, -2.0719846236336505), (1.1886132007698116, -0.3536164022067534),"," (6.352402886166338, 1.1611508021908197), (-2.022942439568281, -2.1399393858935674),"," (4.709789433664545, 1.942684870640507), (-6.574823996383105, 0.6222381708205749),"," (5.156978995662392, 0.18598357294607748), (-3.9429733387502397, 0.9422902185352964),"," (3.2174556042597082, -2.192178218667582), (1.9723954458796467, -2.060247190990375),"," (-6.42021189862825, -1.4527477865998373), (-2.319201156447999, -1.1399365655669222),"," (2.054690682222029, 1.1481007251527764), (6.458528913439745, 1.877440052450945),"," (6.909084732340975, 0.907207420594264), (-2.7116161245851265, -2.28324975884402),"," (1.7325252525767105, -0.3617422941387307), (2.4432102600568957, -2.7136762313350236),"," (-4.3009253710314095, 1.5892890433090239), (1.4194535258877217, 0.41591084432990577),"," (-5.6609671758560225, -1.1243041911643785), (5.741305606648977, 0.17651598128675472),","       (6.883153605373632, -2.1761551216783097)]","","Px = sorted(Pts)                       # by x-coordinate","Py = sorted(Pts, key=lambda p: p[1])   # by y-coordinate","","def closest_pair(Px, Py):","    n = len(Px)","    if n <= 3:                         # base case: check every pair","        return min(distance(Px[i], Px[j])","                   for i in range(n) for j in range(i + 1, n))","    m = n // 2","    Qx, Rx = Px[:m], Px[m:]            # split at the median x","    xQ, xR = Qx[-1][0], Rx[0][0]","    line_x = (xQ + xR) / 2","    Qy = [p for p in Py if p[0] < xR]  # same split, y-order kept","    Ry = [p for p in Py if p[0] >= xR]","    dQ = closest_pair(Qx, Qy)          # best inside the left half","    dR = closest_pair(Rx, Ry)          # best inside the right half","    delta = min(dQ, dR)","    Sy = [p for p in Py if abs(p[0] - line_x) <= delta]  # y-sorted strip","    minS = delta","    for i in range(len(Sy)):           # each strip point checks only the","        for j in range(i + 1, len(Sy)):  # few neighbours above it","            if Sy[j][1] - Sy[i][1] >= minS:","                break                  # too far above: can't improve","            minS = min(minS, distance(Sy[i], Sy[j]))","    return min(delta, minS)","","print(round(closest_pair(Px, Py), 2))"],"map":[{"lines":"4-22","time":0.0},{"lines":"24-25","time":0.0},{"lines":"32-37","time":0.0},{"lines":"38","time":1.6667},{"lines":"32-37","time":2.6667},{"lines":"38","time":4.3333},{"lines":"32-37","time":5.3333},{"lines":"38","time":7.0},{"lines":"32-37","time":8.0},{"lines":"38","time":9.6667},{"lines":"29-31","time":10.6667},{"lines":"39","time":12.3333},{"lines":"29-31","time":13.3333},{"lines":"40","time":15.8667},{"lines":"41","time":17.5333},{"lines":"43-46","time":20.8667},{"lines":"47","time":21.5333},{"lines":"43-46","time":22.2667},{"lines":"39","time":23.7333},{"lines":"32-37","time":24.7333},{"lines":"38","time":26.4},{"lines":"29-31","time":27.4},{"lines":"39","time":28.7333},{"lines":"29-31","time":29.7333},{"lines":"40","time":32.2667},{"lines":"41","time":33.9333},{"lines":"43-46","time":37.2667},{"lines":"40","time":39.2667},{"lines":"41","time":40.9333},{"lines":"43-46","time":44.2667},{"lines":"47","time":44.9333},{"lines":"43-46","time":45.6667},{"lines":"39","time":47.8667},{"lines":"32-37","time":48.8667},{"lines":"38","time":50.5333},{"lines":"32-37","time":51.5333},{"lines":"38","time":53.2},{"lines":"29-31","time":54.2},{"lines":"39","time":56.2},{"lines":"29-31","time":57.2},{"lines":"40","time":59.7333},{"lines":"41","time":61.4},{"lines":"43-46","time":64.