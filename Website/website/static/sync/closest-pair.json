time":143.3333},{"lines":"62","time":147.4},{"lines":"52-59","time":148.4},{"lines":"61","time":150.0667},{"lines":"51","time":151.0667},{"lines":"62","time":152.4},{"lines":"51","time":153.4},{"lines":"63","time":155.2667},{"lines":"65","time":156.9333},{"lines":"67-69","time":160.2667},{"lines":"63","time":162.2667},{"lines":"65","time":163.9333},{"lines":"63","time":168.5333},{"lines":"65","time":170.2},{"lines":"63","time":172.6},{"lines":"65","time":174.2667},{"lines":"82","time":178.3333},{"lines":"82","time":181.3333}]},"java":{"code":["class Pt { double x, y; Pt(double x, double y) { this.x = x; this.y = y; } }","","double distance(Pt p, Pt q) {","    double dx = p.x - q.x, dy = p.y - q.y;","    return Math.sqrt(dx * dx + dy * dy);","}","","// the 35 demo points: x in [-7, 7], y in [-3.2, 2]","Pt[] Pts = {","    new Pt(-6.828104536428343, -2.615525922382774), new Pt(-1.5002769382896037, 0.35609422195698803),","    new Pt(-5.058326934995169, -2.615293473131186), new Pt(-3.7547670009646965, 0.7394809240540603),","    new Pt(-4.936382906556102, 0.6514070344880314), new Pt(2.2703331772136846, -2.4897916734063634),","    new Pt(0.49926446566904215, -0.8716951643261255), new Pt(-1.2240188355072914, 1.9809871962966294),","    new Pt(-5.696440550282041, -3.0940944164597317), new Pt(6.157226819003869, -1.1046817796232347),","    new Pt(-4.221033149339351, -1.4823910740160482), new Pt(-1.8914738866985337, 1.7665868020216315),","    new Pt(-4.055348082366278, -2.0719846236336505), new Pt(1.1886132007698116, -0.3536164022067534),","    new Pt(6.352402886166338, 1.1611508021908197), new Pt(-2.022942439568281, -2.1399393858935674),","    new Pt(4.709789433664545, 1.942684870640507), new Pt(-6.574823996383105, 0.6222381708205749),","    new Pt(5.156978995662392, 0.18598357294607748), new Pt(-3.9429733387502397, 0.9422902185352964),","    new Pt(3.2174556042597082, -2.192178218667582), new Pt(1.9723954458796467, -2.060247190990375),","    new Pt(-6.42021189862825, -1.4527477865998373), new Pt(-2.319201156447999, -1.1399365655669222),","    new Pt(2.054690682222029, 1.1481007251527764), new Pt(6.458528913439745, 1.877440052450945),","    new Pt(6.909084732340975, 0.907207420594264), new Pt(-2.7116161245851265, -2.28324975884402),","    new Pt(1.7325252525767105, -0.3617422941387307), new Pt(2.4432102600568957, -2.7136762313350236),","    new Pt(-4.3009253710314095, 1.5892890433090239), new Pt(1.4194535258877217, 0.41591084432990577),","    new Pt(-5.6609671758560225, -1.1243041911643785), new Pt(5.741305606648977, 0.17651598128675472),","    new Pt(6.883153605373632, -2.1761551216783097)","};","","double bruteForce(Pt[] P, int n) {","    double best = 1e18;","    for (int i = 0; i < n; i++)","        for (int j = i + 1; j < n; j++) {","            double d = distance(P[i], P[j]);","            if (d < best) best = d;","        }","    return best;","}","","double closestPair(Pt[] Px, Pt[] Py, int n) {","    if (n <= 3) return bruteForce(Px, n);  // base case: check every pair","    int m = n / 2;                         // split at the median x","    double xQ = Px[m - 1].x, xR = Px[m].x;","    double lineX = (xQ + xR) / 2;","    Pt[] Qy = new Pt[n], Ry = new Pt[n], Sy = new Pt[n];","    int nq = 0, nr = 0, ns = 0;","    for (int i = 0; i < n; i++) {          // same split, y-order kept","        if (Py[i].x < xR) Qy[nq++] = Py[i];","        else Ry[nr++] = Py[i];","    }","    double dQ = closestPair(Arrays.copyOf(Px, m), Qy, m);             // best inside the left half","    double dR = closestPair(Arrays.copyOfRange(Px, m, n), Ry, n - m); // best inside the right half","    double delta = Math.min(dQ, dR);","    for (int i = 0; i < n; i++)             // y-sorted strip around the line","        if (Math.abs(Py[i].x - lineX) <= delta) Sy[ns++] = Py[i];","    double minS = delta;","    for (int i = 0; i < ns; i++)            // each strip point checks only the","        for (int j = i + 1; j < ns; j++) {  // few neighbours above it","            if (Sy[j].y - Sy[i].y >= minS) break;  // too far above: can't improve","            double d = distance(Sy[i], Sy[j]);","            if (d < minS) minS = d;","        }","    return Math.min(delta, minS);","}","","double runDemo() {","    Pt[] px = Arrays.copyOf(Pts, 35), py = Arrays.copyOf(Pts, 35);","    Arrays.sort(px, (a, b) -> Double.compare(a.x, b.x));  // by x-coordinate","    Arrays.sort(py, (a, b) -> Double.compare(a.y, b.y));  // by y-coordinate","    return closestPair(px, py, 35);","}"],"map":[{"lines":"8-27","time":0.0},{"lines":"68-69","time":0.0},{"lines":"42-49","time":0.0},{"lines":"51","time":1.6667},{"lines":"42-49","time":2.6667},{"lines":"51","time":4.3333},{"lines":"42-49","time":5.3333},{"lines":"51","time":7.0},{"lines":"42-49","time":8.0},{"lines":"51","time":9.6667},{"lines":"41","time":10.6667},{"lines":"52","time":12.3333},{"lines":"41","time":13.3333},{"lines":"53","time":15.8667},{"lines":"55","time":17.5333},{"lines":"57-59","time":20.8667},{"lines":"61","time":21.5333},{"lines":"57-59","time":22.2667},{"lines":"52","time":23.7333},{"lines":"42-49","time":24.7333},{"lines":"51","time":26.4},{"lines":"41","time":27.4},{"lines":"52","time":28.7333},{"lines":"41","time":29.7333},{"lines":"53","time":32.2667},{"lines":"55","time":33.9333},{"lines":"57-59","time":37.2667},{"lines":"53","time":39.2667},{"lines":"55","time":40.9333},{"lines":"57-59","time":44.2667},{"lines":"61","time":44.9333},{"lines":"57-59","time":45.6667},{"lines":"52","time":47.8667},{"lines":"42-49","time":48.8667},{"lines":"51","time":50.5333},{"lines":"42-49","time":51.5333},{"lines":"51","time":53.2},{"lines":"41","time":54.2},{"lines":"52","time":56.2},{"lines":"41","time":57.2},{"lines":"53","time":59.7333},{"lines":"55","time":61.4},{"lines":"57-59","time":64.7333},{"lines":"52","time":66.2},{"lines":"42-49","time":67.2},{"lines":"51","time":68.8667},{"lines":"41","time":69.8667},{"lines":"52","time":71.2},{"lines":"41","time":72.2},{"lines":"53","ti