{"default":"python","langs":{"c":{"code":["typedef struct { double x, y; } Point;","","double distance(Point p, Point q) {","    double dx = p.x - q.x, dy = p.y - q.y;","    return sqrt(dx * dx + dy * dy);","}","","int cmp_x(const void *a, const void *b) {","    const Point *p = (const Point *)a, *q = (const Point *)b;","    return p->x < q->x ? -1 : p->x > q->x;","}","","int cmp_y(const void *a, const void *b) {","    const Point *p = (const Point *)a, *q = (const Point *)b;","    return p->y < q->y ? -1 : p->y > q->y;","}","","/* the 35 demo points: x in [-7, 7], y in [-3.2, 2] */","Point Pts[35] = {","    {-6.828104536428343, -2.615525922382774}, {-1.5002769382896037, 0.35609422195698803},","    {-5.058326934995169, -2.615293473131186}, {-3.7547670009646965, 0.7394809240540603},","    {-4.936382906556102, 0.6514070344880314}, {2.2703331772136846, -2.4897916734063634},","    {0.49926446566904215, -0.8716951643261255}, {-1.2240188355072914, 1.9809871962966294},","    {-5.696440550282041, -3.0940944164597317}, {6.157226819003869, -1.1046817796232347},","    {-4.221033149339351, -1.4823910740160482}, {-1.8914738866985337, 1.7665868020216315},","    {-4.055348082366278, -2.0719846236336505}, {1.1886132007698116, -0.3536164022067534},","    {6.352402886166338, 1.1611508021908197}, {-2.022942439568281, -2.1399393858935674},","    {4.709789433664545, 1.942684870640507}, {-6.574823996383105, 0.6222381708205749},","    {5.156978995662392, 0.18598357294607748}, {-3.9429733387502397, 0.9422902185352964},","    {3.2174556042597082, -2.192178218667582}, {1.9723954458796467, -2.060247190990375},","    {-6.42021189862825, -1.4527477865998373}, {-2.319201156447999, -1.1399365655669222},","    {2.054690682222029, 1.1481007251527764}, {6.458528913439745, 1.877440052450945},","    {6.909084732340975, 0.907207420594264}, {-2.7116161245851265, -2.28324975884402},","    {1.7325252525767105, -0.3617422941387307}, {2.4432102600568957, -2.7136762313350236},","    {-4.3009253710314095, 1.5