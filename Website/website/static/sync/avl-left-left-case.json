{"default":"python","langs":{"c":{"code":["/* Left-Left case: balance > 1, deep path goes LEFT then LEFT */","/* -> a single RIGHT rotation restores balance */","","/* when it fires (inside insert):","   if (balance > 1 && key < root->left->key)","       return right_rotate(root);","*/","","struct Node *right_rotate(struct Node *z) {","    struct Node *y = z->left;      /* the new subtree root */","    struct Node *T3 = y->right;    /* detaches */","    y->right = z;                  /* z drops down */","    z->left = T3;                  /* z adopts T3 */","    z->height = 1 + max(height(z->left), height(z->right));","    y->height = 1 + max(height(y->left), height(y->right));","    return y;","}"],"map":[{"lines":"1-7","time":0.0},{"lines":"12-13","time":31.8},{"lines":"14-16","time":37.3333},{"lines":"14-16","time":41.3333}]},"cpp":{"code":["// Left-Left case: balance > 1, deep path goes LEFT then LEFT","// -> a single RIGHT rotation restores balance","","// when it fires (inside insert):","//   if (balance > 1 && key < root->left->key)","//       return right_rotate(root);","","Node *right_rotate(Node *z) {","    Node *y = z->left;       // the new subtree root","    Node *T3 = y->right;     // detaches","    y->right = z;            // z drops down","    z->left = T3;            // z adopts T3","    z->height = 1 + std::max(height(z->left), height(z->right));","    y->height = 1 + std::max(height(y->left), height(y->right));","    return y;","}"],"map":[{"lines":"1-6","time":0.0},{"lines":"12-13","time":31.8},{"lines":"14-16","time":37.3333},{"lines":"14-16","time":41.3333}]},"java":{"code":["// Left-Left case: balance > 1, deep path goes LEFT then LEFT","// -> a single RIGHT rotation restores balance","","// when it fires (inside insert):","//   if (balance > 1 && key < root.left.key)","//       return rightRotate(root);","","Node rightRotate(Node z) {","    Node y = z.left;         // the new subtree root","    Node T3 = y.right;       // detaches","    y.right = z;             // z drops down","    z.left = T3;             // z adopts T3","    z.height = 1 + Math.max(height(z.left), height(z.right));","    y.height = 1 + Math.max(height(y.left), height(y.right));","    return y;","}"],"map":[{"lines":"1-6","time":0.0},{"lines":"12-13","time":31.8},{"lines":"14-16","time":37.3333},{"lines":"14-16","time":41.3333}]},"python":{"code":["# Left-Left case: balance > 1 and the deep path goes LEFT then LEFT","# -> a single RIGHT rotation restores balance","","# when it fires (inside insert):","#   if balance > 1 and key < root.left.key:","#       return right_rotate(root)","","def right_rotate(z):","    y = z.left              # z left child - the new subtree root","    T3 = y.right            # y right subtree detaches","    y.right = z             # z drops down to become y right child","    z.left = T3             # z adopts y old right subtree","    z.height = 1 + max(height(z.left), height(z.right))","    y.height = 1 + max(height(y.left), height(y.right))","    return y               # y is the new subtree root"],"map":[{"lines":"1-6","time":0.0},{"lines":"11-12","time":31.8},{"lines":"13-15","time":37.3333},{"lines":"13-15","time":41.3333}]}},"video":"Videos/AVLTree/LeftLeftCase.webm"}
