{"default":"python","langs":{"c":{"code":["/* demo tree: A-(B, C), B-(D, E), C-(F, G, H), D-(I, J), E-(K) */","","void bfs(struct Node *root) {","    struct Node *queue[16];","    int head = 0, tail = 0;          /* FIFO: the oldest node leaves first */","    queue[tail++] = root;","    while (head < tail) {","        struct Node *current = queue[head++];   /* leave from the front */","        visit(current);              /* visit */","        for (int i = 0; i < current->count; i++)","            queue[tail++] = current->children[i];  /* discoveries join at the rear */","    }","}","/* bfs(root) visits: A B C D E F G H I J K */"],"map":[{"lines":"1","time":0.0},{"lines":"8-9","time":9.1333},{"lines":"11","time":10.0},{"lines":"8-9","time":16.7333},{"lines":"11","time":17.6},{"lines":"8-9","time":24.3333},{"lines":"11","time":25.2},{"lines":"8-9","time":34.3333},{"lines":"11","time":35.2},{"lines":"8-9","time":41.9333},{"lines":"11","time":42.8},{"lines":"8-9","time":47.1333},{"lines":"8-9","time":75.3333}]},"cpp":{"code":["// demo tree: A-(B, C), B-(D, E), C-(F, G, H), D-(I, J), E-(K)","","void bfs(Node *root) {","    std::queue<Node *> queue;        // FIFO: the oldest node leaves first","    queue.push(root);","    while (!queue.empty()) {","        Node *current = queue.front();   // leave from the front","        queue.pop();","        visit(current);              // visit","        for (Node *child : current->children)","            queue.push(child);      // discoveries join at the rear","    }","}","// bfs(root) visits: A B C D E F G H I J K"],"map":[{"lines":"1","time":0.0},{"lines":"8-10","time":9.1333},{"lines":"12","time":10.0},{"lines":"8-10","time":16.7333},{"lines":"12","time":17.6},{"lines":"8-10","time":24.3333},{"lines":"12","time":25.2},{"lines":"8-10","time":34.3333},{"lines":"12","time":35.2},{"lines":"8-10","time":41.9333},{"lines":"12","time":42.8},{"lines":"8-10","time":47.1333},{"lines":"8-10","time":75.3333}]},"java":{"code":["// demo tree: A-(B, C), B-(D, E), C-(F, G, H), D-(I, J), E-(K)","","void bfs(Node root) {","    Queue<Node> queue = new ArrayDeque<>();   // FIFO: oldest first","    queue.add(root);","    while (!queue.isEmpty()) {","        Node current = queue.poll();           // leave from the front","        visit(current);                        // visit","        for (Node child : current.children)","            queue.add(child);                  // discoveries join at the rear","    }","}","// bfs(root) visits: A B C D E F G H I J K"],"map":[{"lines":"1","time":0.0},{"lines":"7-8","time":9.1333},{"lines":"10","time":10.0},{"lines":"7-8","time":16.7333},{"lines":"10","time":17.6},{"lines":"7-8","time":24.3333},{"lines":"10","time":25.2},{"lines":"7-8","time":34.3333},{"lines":"10","time":35.2},{"lines":"7-8","time":41.9333},{"lines":"10","time":42.8},{"lines":"7-8","time":47.1333},{"lines":"7-8","time":75.3333}]},"python":{"code":["from collections import deque","","# demo tree: A-(B, C), B-(D, E), C-(F, G, H), D-(I, J), E-(K)","root = build_tree()","","def bfs(root):","    order = []","    queue = deque([root])       # FIFO: the oldest node leaves first","    while queue:","        current = queue.popleft()","        order.append(current.data)   # visit","        for child in current.children:","            queue.append(child)      # discoveries join at the rear","    return order","","bfs(root)   # A B C D E F G H I J K"],"map":[{"lines":"3-4","time":0.0},{"lines":"10-11","time":9.1333},{"lines":"13","time":10.0},{"lines":"10-11","time":16.7333},{"lines":"13","time":17.6},{"lines":"10-11","time":24.3333},{"lines":"13","time":25.2},{"lines":"10-11","time":34.3333},{"lines":"13","time":35.2},{"lines":"10-11","time":41.9333},{"lines":"13","time":42.8},{"lines":"10-11","time":47.1333},{"lines":"10-11","time":75.3333}]}},"video":"Videos/Trees/TreeBFS.webm"}
