{"default":"python","langs":{"c":{"code":["/* the demo graph: dist[i][j] starts as the direct edge weight */","double dist[7][7];                   /* inf = no direct edge */","","void floyd_warshall(void) {","    for (int i = 0; i < 7; i++)","        for (int j = 0; j < 7; j++)","            dist[i][j] = (i == j) ? 0 : 1e18;","    int wedge[10][3] = {{0,6,8},{0,1,10},{6,1,-4},{1,5,2},{6,5,-1},","                         {5,2,-2},{2,1,1},{2,3,1},{3,4,3},{4,5,-1}};","    for (int e = 0; e < 10; e++)","        dist[wedge[e][0]][wedge[e][1]] = wedge[e][2];","","    for (int k = 0; k < 7; k++)      /* allow vertex k as intermediate */","        for (int i = 0; i < 7; i++)","            for (int j = 0; j < 7; j++)","                if (dist[i][k] + dist[k][j] < dist[i][j])","                    dist[i][j] = dist[i][k] + dist[k][j];","    /* negative diagonal after the loops = negative cycle */","}"],"map":[{"lines":"2","time":0.0},{"lines":"11","time":9.0},{"lines":"13","time":12.7333},{"lines":"17","time":13.2667},{"lines":"13","time":59.0},{"lines":"17","time":59.5333},{"lines":"13","time":111.4667},{"lines":"17","time":112.0},{"lines":"13","time":161.8667},{"lines":"17","time":162.4},{"lines":"13","time":212.2667},{"lines":"17","time":212.8},{"lines":"13","time":260.6},{"lines":"17","time":261.1333},{"lines":"13","time":335.8},{"lines":"17","time":336.3333},{"lines":"17","time":396.4}]},"cpp":{"code":["// the demo graph: dist[i][j] starts as the direct edge weight ","double dist[7][7];                   // inf = no direct edge ","","void floyd_warshall(void) {","    for (int i = 0; i < 7; i++)","        for (int j = 0; j < 7; j++)","            dist[i][j] = (i == j) ? 0 : 1e18;","    int wedge[10][3] = {{0,6,8},{0,1,10},{6,1,-4},{1,5,2},{6,5,-1},","                         {5,2,-2},{2,1,1},{2,3,1},{3,4,3},{4,5,-1}};","    for (int e = 0; e < 10; e++)","        dist[wedge[e][0]][wedge[e][1]] = wedge[e][2];","","    for (int k = 0; k < 7; k++)      // allow vertex k as intermediate ","        for (int i = 0; i < 7; i++)","            for (int j = 0; j < 7; j++)","                if (dist[i][k] + dist[k][j] < dist[i][j])","                    dist[i][j] = dist[i][k] + dist[k][j];","    // negative diagonal after the loops = negative cycle ","}"],"map":[{"lines":"2","time":0.0},{"lines":"11","time":9.0},{"lines":"13","time":12.7333},{"lines":"17","time":13.2667},{"lines":"13","time":59.0},{"lines":"17","time":59.5333},{"lines":"13","time":111.4667},{"lines":"17","time":112.0},{"lines":"13","time":161.8667},{"lines":"17","time":162.4},{"lines":"13","time":212.2667},{"lines":"17","time":212.8},{"lines":"13","time":260.6},{"lines":"17","time":261.1333},{"lines":"13","time":335.8},{"lines":"17","time":336.3333},{"lines":"17","time":396.4}]},"java":{"code":["// the demo graph: dist[i][j] starts as the direct edge weight","double[][] dist = new double[7][7];  // inf = no direct edge","","void floydWarshall() {","    for (int i = 0; i < 7; i++)","        for (int j = 0; j < 7; j++)","            dist[i][j] = (i == j) ? 0 : Double.POSITIVE_INFINITY;","    int[][] wedge = { {0,6,8},{0,1,10},{6,1,-4},{1,5,2},{6,5,-1},","                      {5,2,-2},{2,1,1},{2,3,1},{3,4,3},{4,5,-1} };","    for (int[] e : wedge)","        dist[e[0]][e[1]] = e[2];","","    for (int k = 0; k < 7; k++)      // allow vertex k as intermediate","        for (int i = 0; i < 7; i++)","            for (int j = 0; j < 7; j++)","                if (dist[i][k] + dist[k][j] < dist[i][j])","                    dist[i][j] = dist[i][k] + dist[k][j];","    // negative diagonal after the loops = negative cycle","}"],"map":[{"lines":"2","time":0.0},{"lines":"11","time":9.0},{"lines":"13","time":12.7333},{"lines":"17","time":13.2667},{"lines":"13","time":59.0},{"lines":"17","time":59.5333},{"lines":"13","time":111.4667},{"lines":"17","time":112.0},{"lines":"13","time":161.8667},{"lines":"17","time":162.4},{"lines":"13","time":212.2667},{"lines":"17","time":212.8},{"lines":"13","time":260.6},{"lines":"17","time":261.1333},{"lines":"13","time":335.8},{"lines":"17","time":336.3333},{"lines":"17","time":396.4}]},"python":{"code":["# the demo graph: dist[i][j] starts as the direct edge weight","dist = [[0 if i == j else float('inf') for j in range(7)] for i in range(7)]","for u, v, w in [(0, 6, 8), (0, 1, 10), (6, 1, -4), (1, 5, 2), (6, 5, -1),","                 (5, 2, -2), (2, 1, 1), (2, 3, 1), (3, 4, 3), (4, 5, -1)]:","    dist[u][v] = w","","for k in range(7):                  # allow vertex k as intermediate","    for i in range(7):","        for j in range(7):","            if dist[i][k] + dist[k][j] < dist[i][j]:","                dist[i][j] = dist[i][k] + dist[k][j]","","# negative diagonal after the loops = negative cycle"],"map":[{"lines":"2","time":0.0},{"lines":"5","time":9.0},{"lines":"7","time":12.7333},{"lines":"10","time":13.2667},{"lines":"7","time":59.0},{"lines":"10","time":59.5333},{"lines":"7","time":111.4667},{"lines":"10","time":112.0},{"lines":"7","time":161.8667},{"lines":"10","time":162.4},{"lines":"7","time":212.2667},{"lines":"10","time":212.8},{"lines":"7","time":260.6},{"lines":"10","time":261.1333},{"lines":"7","time":335.8},{"lines":"10","time":336.3333},{"lines":"10","time":396.4}]}},"video":"Videos/Graphs/FloydWarshall.webm"}
