{"default":"python","langs":{"c":{"code":["/* a min-heap: every parent <= its children (array form) */","int heap[64];","int size = 0;","","/* join at the next free slot, then swap up while the child is the outlier */","void insert(int value) {","    heap[size] = value;                 /* join at the next free slot */","    size++;","    int i = size - 1;","    while (i > 0) {","        int parent = (i - 1) / 2;","        if (heap[i] < heap[parent]) {   /* child vs parent? */","            int tmp = heap[i]; heap[i] = heap[parent]; heap[parent] = tmp;","            i = parent;","        } else {","            break;                       /* heap property holds again */","        }","    }","}","/* insert 26, 7, 2, 25, 19, 17, 1, 90, 36, 3:","   the array becomes 1 3 2 26 19 17 7 90 36 25 */"],"map":[{"lines":"6","time":0.0},{"lines":"7-8","time":0.8},{"lines":"6","time":2.2667},{"lines":"7-8","time":3.0667},{"lines":"12-13","time":4.6},{"lines":"6","time":8.0667},{"lines":"7-8","time":8.8667},{"lines":"12-13","time":10.4},{"lines":"6","time":13.8667},{"lines":"7-8","time":14.6667},{"lines":"12-13","time":16.2},{"lines":"16","time":18.7333},{"lines":"6","time":21.4},{"lines":"7-8","time":22.2},{"lines":"12-13","time":23.7333},{"lines":"16","time":26.2667},{"lines":"6","time":28.9333},{"lines":"7-8","time":29.7333},{"lines":"16","time":31.3333},{"lines":"6","time":34.0},{"lines":"7-8","time":34.8},{"lines":"12-13","time":36.3333},{"lines":"6","time":42.2667},{"lines":"7-8","time":43.0667},{"lines":"16","time":44.6667},{"lines":"6","time":47.3333},{"lines":"7-8","time":48.1333},{"lines":"16","time":49.7333},{"lines":"6","time":52.4},{"lines":"7-8","time":53.2},{"lines":"12-13","time":54.7333},{"lines":"16","time":59.7333},{"lines":"16","time":64.4}]},"cpp":{"code":["// a min-heap: every parent <= its children (array form)","std::vector<int> heap;","","// join at the next free slot, then swap up while the child is the outlier","void insert(int value) {","    heap.push_back(value);             // join at the next free slot","    int i = heap.size() - 1;","    while (i > 0) {","        int parent = (i - 1) / 2;","        if (heap[i] < heap[parent]) {   // child vs parent?","            std::swap(heap[i], heap[parent]);","            i = parent;","        } else {","            break;                      // heap property holds again","        }","    }","}","// insert 26, 7, 2, 25, 19, 17, 1, 90, 36, 3 -> the array becomes 1 3 2 26 19 17 7 90 36 25"],"map":[{"lines":"5","time":0.0},{"lines":"6","time":0.8},{"lines":"5","time":2.2667},{"lines":"6","time":3.0667},{"lines":"10-11","time":4.6},{"lines":"5","time":8.0667},{"lines":"6","time":8.8667},{"lines":"10-11","time":10.4},{"lines":"5","time":13.8667},{"lines":"6","time":14.6667},{"lines":"10-11","time":16.2},{"lines":"14","time":18.7333},{"lines":"5","time":21.4},{"lines":"6","time":22.2},{"lines":"10-11","time":23.7333},{"lines":"14","time":26.2667},{"lines":"5","time":28.9333},{"lines":"6","time":29.7333},{"lines":"14","time":31.3333},{"lines":"5","time":34.0},{"lines":"6","time":34.8},{"lines":"10-11","time":36.3333},{"lines":"5","time":42.2667},{"lines":"6","time":43.0667},{"lines":"14","time":44.6667},{"lines":"5","time":47.3333},{"lines":"6","time":48.1333},{"lines":"14","time":49.7333},{"lines":"5","time":52.4},{"lines":"6","time":53.2},{"lines":"10-11","time":54.7333},{"lines":"14","time":59.7333},{"lines":"14","time":64.4}]},"java":{"code":["// a min-heap: every parent <= its children (array form)","int[] heap = new int[64];","int size = 0;","","// join at the next free slot, then swap up while the child is the outlier","void insert(int value) {","    heap[size] = value;                 // join at the next free slot","    size++;","    int i = size - 1;","    while (i > 0) {","        int parent = (i - 1) / 2;","        if (heap[i] < heap[parent]) {   // child vs parent?","            int tmp = heap[i]; heap[i] = heap[parent]; heap[parent] = tmp;","            i = parent;","        } else {","            break;                      // heap property holds again","        }","    }","}","// insert 26, 7, 2, 25, 19, 17, 1, 90, 36, 3","// -> the array becomes 1 3 2 26 19 17 7 90 36 25"],"map":[{"lines":"6","time":0.0},{"lines":"7-8","time":0.8},{"lines":"6","time":2.2667},{"lines":"7-8","time":3.0667},{"lines":"12-13","time":4.6},{"lines":"6","time":8.0667},{"lines":"7-8","time":8.8667},{"lines":"12-13","time":10.4},{"lines":"6","time":13.8667},{"lines":"7-8","time":14.6667},{"lines":"12-13","time":16.2},{"lines":"16","time":18.7333},{"lines":"6","time":21.4},{"lines":"7-8","time":22.2},{"lines":"12-13","time":23.7333},{"lines":"16","time":26.2667},{"lines":"6","time":28.9333},{"lines":"7-8","time":29.7333},{"lines":"16","time":31.3333},{"lines":"6","time":34.0},{"lines":"7-8","time":34.8},{"lines":"12-13","time":36.3333},{"lines":"6","time":42.2667},{"lines":"7-8","time":43.0667},{"lines":"16","time":44.6667},{"lines":"6","time":47.3333},{"lines":"7-8","time":48.1333},{"lines":"16","time":49.7333},{"lines":"6","time":52.4},{"lines":"7-8","time":53.2},{"lines":"12-13","time":54.7333},{"lines":"16","time":59.7333},{"lines":"16","time":64.4}]},"python":{"code":["# a min-heap: every parent <= its children (array form)","heap = []","","def insert(heap, value):","    heap.append(value)              # join at the next free slot (level order)","    i = len(heap) - 1","    while i > 0:","        parent = (i - 1) // 2","        if heap[i] < heap[parent]:  # child smaller than the parent?","            heap[i], heap[parent] = heap[parent], heap[i]   # swap up","            i = parent","        else:","            break                   # parent <= child: heap property holds","","for value in [26, 7, 2, 25, 19, 17, 1, 90, 36, 3]:","    insert(heap, value)","","print(heap)   # [1, 3, 2, 26, 19, 17, 7, 90, 36, 25]"],"map":[{"lines":"15","time":0.0},{"lines":"5","time":0.8},{"lines":"15","time":2.2667},{"lines":"5","time":3.0667},{"lines":"9-10","ti