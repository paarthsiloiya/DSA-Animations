{"default":"python","langs":{"c":{"code":["/* demo intervals: (id, start, finish) */","int starts[9] = {1, 3, 1, 4, 2, 5, 7, 10, 9};","int fins[9]   = {2, 6, 5, 7, 5, 8, 10, 13, 12};","int order[9];      /* ids sorted by finish time */","","int cmp_order(const void *a, const void *b) {","    int x = *(const int *)a, y = *(const int *)b;","    if (fins[x] != fins[y]) return fins[x] < fins[y] ? -1 : 1;","    return x < y ? -1 : x > y;     /* stable: lower id first on ties */","}","","void sort_by_finish(void) {","    for (int k = 0; k < 9; k++) order[k] = k;","    qsort(order, 9, sizeof(int), cmp_order);","}","","int accepted[9];    /* ids of the chosen intervals */","int n_accepted = 0;","","void greedy(void) {","    accepted[n_accepted++] = order[0];   /* earliest finish is always safe */","    int last_finish = fins[order[0]];","    for (int k = 1; k < 9; k++) {        /* scan earliest finish first */","        int id = order[k];","        if (starts[id] >= last_finish) { /* fits after the last accepted? */","            accepted[n_accepted++] = id; /* take it */","            last_finish = fins[id];","        }                                /* else: overlaps - skip it */","    }","}","","/* result: ids 0, 4, 5, 8 (4 intervals of 9) */"],"map":[{"lines":"1-4","time":0.0},{"lines":"14","time":0.0},{"lines":"21-22","time":4.0},{"lines":"23-25","time":6.7333},{"lines":"28","time":8.2667},{"lines":"23-25","time":11.6},{"lines":"26-27","time":13.1333},{"lines":"23-25","time":16.4667},{"lines":"28","time":18.0},{"lines":"23-25","time":21.3333},{"lines":"28","time":22.8667},{"lines":"23-25","time":26.2},{"lines":"26-27","time":27.7333},{"lines":"23-25","time":31.0667},{"lines":"28","time":32.6},{"lines":"23-25","time":35.9333},{"lines":"26-27","time":37.4667},{"lines":"23-25","time":40.8},{"lines":"28","time":42.3333},{"lines":"32","time":46.6667},{"lines":"32","time":50.6667}]},"cpp":{"code":["// demo intervals: (id, start, finish) ","int starts[9] = {1, 3, 1, 4, 2, 5, 7, 10, 9};","int fins[9]   = {2, 6, 5, 7, 5, 8, 10, 13, 12};","int order[9];      // ids sorted by finish time ","","int cmp_order(const void *a, const void *b) {","    int x = *(const int *)a, y = *(const int *)b;","    if (fins[x] != fins[y]) return fins[x] < fins[y] ? -1 : 1;","    return x < y ? -1 : x > y;     // stable: lower id first on ties ","}","","void sort_by_finish(void) {","    for (int k = 0; k < 9; k++) order[k] = k;","    qsort(order, 9, sizeof(int), cmp_order);","}","","int accepted[9];    // ids of the chosen intervals ","int n_accepted = 0;","","void greedy(void) {","    accepted[n_accepted++] = order[0];   // earliest finish is always safe ","    int last_finish = fins[order[0]];","    for (int k = 1; k < 9; k++) {        // scan earliest finish first ","        int id = order[k];","        if (starts[id] >= last_finish) { // fits after the last accepted? ","            accepted[n_accepted++] = id; // take it ","            last_finish = fins[id];","        }                                // else: overlaps - skip it ","    }","}","","// result: ids 0, 4, 5, 8 (4 intervals of 9) "],"map":[{"lines":"1-4","time":0.0},{"lines":"14","time":0.0},{"lines":"21-22","time":4.0},{"lines":"23-25","time":6.7333},{"lines":"28","time":8.2667},{"lines":"23-25","time":11.6},{"lines":"26-27","time":13.1333},{"lines":"23-25","time":16.4667},{"lines":"28","time":18.0},{"lines":"23-25","time":21.3333},{"lines":"28","time":22.8667},{"lines":"23-25","time":26.2},{"lines":"26-27","time":27.7333},{"lines":"23-25","time":31.0667},{"lines":"28","time":32.6},{"lines":"23-25","time":35.9333},{"lines":"26-27","time":37.4667},{"lines":"23-25","time":40.8},{"lines":"28","time":42.3333},{"lines":"32","time":46.6667},{"lines":"32","time":50.6667}]},"java":{"code":["// demo intervals: (id, start, finish)","int[] starts = {1, 3, 1, 4, 2, 5, 7, 10, 9};","int[] fins   = {2, 6, 5, 7, 5, 8, 10, 13, 12};","Integer[] order = new Integer[9];       // ids sorted by finish time","","void sortByFinish() {","    for (int k = 0; k < 9; k++) order[k] = k;","    Arrays.sort(order, (x, y) -> fins[x] != fins[y]","            ? Integer.compare(fins[x], fins[y]) : x - y);  // stable: lower id first","}","","int[] accepted = new int[9];            // ids of the chosen intervals","int nAccepted = 0;","","void greedy() {","    accepted[nAccepted++] = order[0];   // earliest finish is always safe","    int lastFinish = fins[order[0]];","    for (int k = 1; k < 9; k++) {        // scan earliest finish first","        int id = order[k];","        if (starts[id] >= lastFinish) {  // fits after the last accepted?","            accepted[nAccepted++] = id; // take it","            lastFinish = fins[id];","        }                                // else: overlaps - skip it","    }","}","","// result: ids 0, 4, 5, 8 (4 intervals of 9)"],"map":[{"lines":"1-4","time":0.0},{"lines":"8","time":0.0},{"lines":"16-17","time":4.0},{"lines":"18-20","time":6.7333},{"lines":"23","time":8.2667},{"lines":"18-20","time":11.6},{"lines":"21-22","time":13.1333},{"lines":"18-20","time":16.4667},{"lines":"23","time":18.0},{"lines":"18-20","time":21.3333},{"lines":"23","time":22.8667},{"lines":"18-20","time":26.2},{"lines":"21-22","time":27.7333},{"lines":"18-20","time":31.0667},{"lines":"23","time":32.6},{"lines":"18-20","time":35.9333},{"lines":"21-22","time":37.4667},{"lines":"18-20","time":40.8},{"lines":"23","time":42.3333},{"lines":"27","time":46.6667},{"lines":"27","time":50.6667}]},"python":{"code":["# demo intervals: (id, start, finish)","intervals = [(0, 1, 2), (1, 3, 6), (2, 1, 5), (3, 4, 7), (4, 2, 5),","             (5, 5, 8), (6, 7, 10), (7, 10, 13), (8, 9, 12)]","","by_finish = sorted(intervals, key=lambda x: x[2])","","accepted = [by_finish[0]]              # earliest finish is always safe","last_finish = by_finish[0][2]","","for i, s, f in by_finish[1:]:          # scan earliest finish first","    if s >= last_finish:               # fits after the last accepted?","        accepted.append((i, s, f))      # take it","        last_finish = f","    # else: overlaps the last accepted - skip it","","print([i for i, s, f in accepted])"],"map":[{"lines":"1-3","time":0.0},{"lines":"5","time":0.0},{"lines":"7-8","time":4.0},{"lines":"10-11","time":6.7333},{"lines":"14","time":8.2667},{"lines":"10-11","time":11.6},{"lines":"12-13","time":13.1333},{"lines":"10-11","time":16.4667},{"lines":"14","time":18.0},{"lines":"10-11","time":21.3333},{"lines":"14","time":22.8667},{"lines":"10-11","time":26.2},{"lines":"12-13","time":27.7333},{"lines":"10-11","time":31.0667},{"lines":"14","time":32.6},{"lines":"10-11","time":35.9333},{"lines":"12-13","time":37.4667},{"lines":"10-11","time":40.8},{"lines":"14","time":42.3333},{"lines":"16","time":46.6667},{"lines":"16","time":50.6667}]}},"video":"Videos/Greedy/IntervalScheduling.webm"}
