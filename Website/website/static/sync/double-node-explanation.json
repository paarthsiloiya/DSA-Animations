{"default":"python","langs":{"c":{"code":["struct Node {","    struct Node *prev;   /* address of the previous node */","    int data;            /* value of this node */","    struct Node *next;   /* address of the next node */","};","","/* a node also lives at its own memory address */","/* (the \"Address of this node\" box, e.g. 0x2268) */","","struct Node n1 = {NULL, 4, NULL}, n2 = {NULL, 1, NULL};","","n1.next = &n2;   /* forward link */","n2.prev = &n1;   /* backward link */"],"map":[{"lines":"10","time":0.0},{"lines":"1-2","time":1.4},{"lines":"2","time":4.4},{"lines":"7-8","time":4.9333},{"lines":"3","time":5.4667},{"lines":"4","time":6.0},{"lines":"10","time":10.7333},{"lines":"12","time":11.7333},{"lines":"13","time":14.7333},{"lines":"13","time":17.7333}]},"cpp":{"code":["struct Node {","    Node *prev;   // address of the previous node","    int data;     // value of this node","    Node *next;   // address of the next node","};","","// a node also lives at its own memory address","// (the \"Address of this node\" box, e.g. 0x2268)","","Node n1 = {nullptr, 4, nullptr}, n2 = {nullptr, 1, nullptr};","","n1.next = &n2;   // forward link","n2.prev = &n1;   // backward link"],"map":[{"lines":"10","time":0.0},{"lines":"1-2","time":1.4},{"lines":"2","time":4.4},{"lines":"7-8","time":4.9333},{"lines":"3","time":5.4667},{"lines":"4","time":6.0},{"lines":"10","time":10.7333},{"lines":"12","time":11.7333},{"lines":"13","time":14.7333},{"lines":"13","time":17.7333}]},"java":{"code":["class Node {","    Node prev;    // address of the previous node","    int data;     // value of this node","    Node next;    // address of the next node","","    Node(int data) { this.data = data; }","}","","// a node also lives at its own memory address","// (the \"Address of this node\" box, e.g. 0x2268)","","Node node1 = new Node(4);","Node node2 = new Node(1);","","node1.next = node2;   // forward link","node2.prev = node1;   // backward link"],"map":[{"lines":"12","time":0.0},{"l