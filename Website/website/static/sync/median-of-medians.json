{"default":"python","langs":{"c":{"code":["/* the 50 demo values */","int arr[50] = {45, 23, 67, 12, 89, 34, 56, 78, 91, 25, 63, 18, 77, 39, 84,","               52, 96, 41, 15, 68, 33, 87, 29, 74, 16, 95, 42, 61, 38, 82,","               57, 94, 21, 76, 43, 85, 19, 66, 31, 79, 48, 92, 26, 73, 14,","               58, 37, 81, 55, 94};","","int cmp_int(const void *a, const void *b) {","    int x = *(const int *)a, y = *(const int *)b;","    return (x > y) - (x < y);","}","","int median_of_medians(int a[], int n) {","    if (n <= 5) {                       /* small list: sort, take the middle */","        qsort(a, n, sizeof(int), cmp_int);","        return a[n / 2];","    }","    int n_groups = (n + 4) / 5;","    int F[10];","    for (int start = 0, g = 0; start < n; start += 5, g++) {","        int len = n - start < 5 ? n - start : 5;","        qsort(a + start, len, sizeof(int), cmp_int);   /* sort each group */","        F[g] = a[start + len / 2];      /* the group median */","    }","    return median_of_medians(F, n_groups);  /* pivot = median of the medians */","}","","/* median_of_medians(arr, 50) == 58 on the demo values */"],"map":[{"lines":"1-27","time":0.0},{"lines":"17-18","time":1.0},{"lines":"19-21","time":23.0},{"lines":"22","time":33.0},{"lines":"24","time":44.8},{"lines":"17-18","time":46.8},{"lines":"19-21","time":52.8},{"lines":"22","time":54.8},{"lines":"24","time":58.6},{"lines":"13-15","time":59.0},{"lines":"13-15","time":64.8}]},"cpp":{"code":["// the 50 demo values ","int arr[50] = {45, 23, 67, 12, 89, 34, 56, 78, 91, 25, 63, 18, 77, 39, 84,","               52, 96, 41, 15, 68, 33, 87, 29, 74, 16, 95, 42, 61, 38, 82,","               57, 94, 21, 76, 43, 85, 19, 66, 31, 79, 48, 92, 26, 73, 14,","               58, 37, 81, 55, 94};","","int cmp_int(const void *a, const void *b) {","    int x = *(const int *)a, y = *(const int *)b;","    return (x > y) - (x < y);","}","","int median_of_medians(int a[], int n) {","    if (n <= 5) {                       // small list: sort, take the middle ","        qsort(a, n, sizeof(int), cmp_int);","        return a[n / 2];","    }","    int n_groups = (n + 4) / 5;","    int F[10];","    for (int start = 0, g = 0; start < n; start += 5, g++) {","        int len = n - start < 5 ? n - start : 5;","        qsort(a + start, len, sizeof(int), cmp_int);   // sort each group ","        F[g] = a[start + len / 2];      // the group median ","    }","    return median_of_medians(F, n_groups);  // pivot = median of the medians ","}","","// median_of_medians(arr, 50) == 58 on the demo values "],"map":[{"lines":"1-27","time":0.0},{"lines":"17-18","time":1.0},{"lines":"19-21","time":23.0},{"lines":"22","time":33.0},{"lines":"24","time":44.8},{"lines":"17-18","time":46.8},{"lines":"19-21","time":52.8},{"lines":"22","time":54.8},{"lines":"24","time":58.6},{"lines":"13-15","time":59.0},{"lines":"13-15","time":64.8}]},"java":{"code":["// the 50 demo values","int[] arr = {45, 23, 67, 12, 89, 34, 56, 78, 91, 25, 63, 18, 77, 39, 84,","             52, 96, 41, 15, 68, 33, 87, 29, 74, 16, 95, 42, 61, 38, 82,","             57, 94, 21, 76, 43, 85, 19, 66, 31, 79, 48, 92, 26, 73, 14,","             58, 37, 81, 55, 94};","","int medianOfMedians(int[] a) {","    if (a.length <= 5) {                 // small list: sort, take the middle","        Arrays.sort(a);","        return a[a.length / 2];","    }","    int nGroups = (a.length + 4) / 5;","    int[] F = new int[nGroups];","    for (int start = 0, g = 0; start < a.length; start += 5, g++) {","        int len = Math.min(5, a.length - start);","        int[] group = Arrays.copyOfRange(a, start, start + len);","        Arrays.sort(group);              // sort each group of 5","        F[g] = group[len / 2];          // the group median","    }","    return medianOfMedians(F);          // pivot = median of the medians","}","","// medianOfMedians(arr) == 58 on the demo values"],"map":[{"lines":"1-23","time":0.0},{"lines":"12-13","time":1.0},{"lines":"14-17","time":23.0},{"lines":"18","time":33.0},{"lines":"20","time":44.8},{"lines":"12-13","time":46.8},{"lines":"14-17","time":52.8},{"lines":"18","time":54.8},{"lines":"20","time":58.6},{"lines":"8-10","time":59.0},{"lines":"8-10","time":64.8}]},"python":{"code":["arr = [45, 23, 67, 12, 89, 34, 56, 78, 91, 25, 63, 18, 77, 39, 84,","       52, 96, 41, 15, 68, 33, 87, 29, 74, 16, 95, 42, 61, 38, 82,","       57, 94, 21, 76, 43, 85, 19, 66, 31, 79, 48, 92, 26, 73, 14,","       58, 37, 81, 55, 94]","","def median_of_medians(a):","    if len(a) <= 5:                    # small list: sort, take the middle","        a.sort()","        return a[len(a) // 2]","    groups = [a[i:i + 5] for i in range(0, len(a), 5)]","    for g in groups:                   # sort each group of 5","        g.sort()","    F = [g[len(g) // 2] for g in groups]  # the group medians","    return median_of_medians(F)        # pivot = median of the medians","","print(median_of_medians(arr))"],"map":[{"lines":"1-4","time":0.0},{"lines":"10","time":1.0},{"lines":"11-13","time":23.0},{"lines":"13","time":33.0},{"lines":"14","time":44.8},{"lines":"10","time":46.8},{"lines":"11-13","time":52.8},{"lines":"13","time":54.8},{"lines":"14","time":58.6},{"lines":"7-9","time":59.0},{"lines":"7-9","time":64.8}]}},"video":"Videos/DivideAndConquer/MedianOfMedians.webm"}
