{"default":"python","langs":{"c":{"code":["/* the demo DAG's out-adjacency (arrows only) */","int adj[8][3] = {{2,3,4},{2,7},{5},{5,7},{7},{6},{7},{}};","int adj_count[8] = {3, 2, 1, 2, 1, 1, 1, 0};","","int indegree[8];                     /* count arriving edges */","int queue[8]; int head = 0, tail = 0;","int order[8]; int ordered = 0;","","void topo_sort(void) {","    for (int v = 0; v < 8; v++) indegree[v] = 0;","    for (int u = 0; u < 8; u++)","        for (int k = 0; k < adj_count[u]; k++)","            indegree[adj[u][k]]++;","    for (int v = 0; v < 8; v++)","        if (indegree[v] == 0) queue[tail++] = v;","    while (head < tail) {","        int v = queue[head++];       /* take a zero-indegree vertex */","        order[ordered++] = v;","        for (int k = 0; k < adj_count[v]; k++) {   /* frees its out-edges */","            int n = adj[v][k];","            if (--indegree[n] == 0)","                queue[tail++] = n;","        }","    }","}"],"map":[{"lines":"3","time":0.0},{"lines":"5","time":9.0},{"lines":"12","time":10.0},{"lines":"15","time":13.2667},{"lines":"17","time":13.8},{"lines":"19","time":15.5333},{"lines":"22","time":23.4},{"lines":"17","time":25.4},{"lines":"19","time":27.1333},{"lines":"22","time":32.8},{"lines":"17","time":34.8},{"lines":"19","time":36.5333},{"lines":"22","time":42.2},{"lines":"17","time":44.2},{"lines":"19","time":45.9333},{"lines":"22","time":49.4},{"lines":"17","time":51.4},{"lines":"19","time":53.1333},{"lines":"22","time":56.6},{"lines":"17","time":58.6},{"lines":"19","time":60.3333},{"lines":"22","time":63.8},{"lines":"17","time":65.8},{"lines":"19","time":67.5333},{"lines":"22","time":71.0},{"lines":"17","time":73.0},{"lines":"22","time":76.0},{"lines":"22","time":83.8}]},"cpp":{"code":["// the demo DAG's out-adjacency (arrows only) ","int adj[8][3] = {{2,3,4},{2,7},{5},{5,7},{7},{6},{7},{}};","int adj_count[8] = {3, 2, 1, 2, 1, 1, 1, 0};","","int indegree[8];                     // count arriving edges ","int queue[8]; int head = 0, tail = 0;","int order[8]; int ordered = 0;","","void topo_sort(void) {","    for (int v = 0; v < 8; v++) indegree[v] = 0;","    for (int u = 0; u < 8; u++)","        for (int k = 0; k < adj_count[u]; k++)","            indegree[adj[u][k]]++;","    for (int v = 0; v < 8; v++)","        if (indegree[v] == 0) queue[tail++] = v;","    while (head < tail) {","        int v = queue[head++];       // take a zero-indegree vertex ","        order[ordered++] = v;","        for (int k = 0; k < adj_count[v]; k++) {   // frees its out-edges ","            int n = adj[v][k];","            if (--indegree[n] == 0)","                queue[tail++] = n;","        }","    }","}"],"map":[{"lines":"3","time":0.0},{"lines":"5","time":9.0},{"lines":"12","time":10.0},{"lines":"15","time":13.2667},{"lines":"17","time":13.8},{"lines":"19","time":15.5333},{"lines":"22","time":23.4},{"lines":"17","time":25.4},{"lines":"19","time":27.1333},{"lines":"22","time":32.8},{"lines":"17","time":34.8},{"lines":"19","time":36.5333},{"lines":"22","time":42.2},{"lines":"17","time":44.2},{"lines":"19","time":45.9333},{"lines":"22","time":49.4},{"lines":"17","time":51.4},{"lines":"19","time":53.1333},{"lines":"22","time":56.6},{"lines":"17","time":58.6},{"lines":"19","time":60.3333},{"lines":"22","time":63.8},{"lines":"17","time":65.8},{"lines":"19","time":67.5333},{"lines":"22","time":71.0},{"lines":"17","time":73.0},{"lines":"22","time":76.0},{"lines":"22","time":83.8}]},"java":{"code":["// the demo DAG's out-adjacency (arrows only)","int[][] adj = { {2,3,4}, {2,7}, {5}, {5,7}, {7}, {6}, {7}, {} };","","int[] indegree = new int[8];         // count arriving edges","Deque<Integer> queue = new ArrayDeque<>();","List<Integer> order = new ArrayList<>();","","void topoSort() {","    for (int u = 0; u < 8; u++)","        for (int n : adj[u])","            indegree[n]++;","    for (int v = 0; v < 8; v++)","        if (indegree[v] == 0) queue.add(v);","    while (!queue.isEmpty()) {","        int v = queue.poll();        // take a zero-indegree vertex","        order.add(v);","        for (int n : adj[v]) {       // frees its out-edges","            if (--indegree[n] == 0)","                queue.add(n);","        }","    }","}"],"map":[{"lines":"2","time":0.0},{"lines":"4","time":9.0},{"lines":"10","time":10.0},{"lines":"13","time":13.2667},{"lines":"15","time":13.8},{"lines":"17","time":15.5333},{"lines":"19","time":23.4},{"lines":"15","time":25.4},{"lines":"17","time":27.1333},{"lines":"19","time":32.8},{"lines":"15","time":34.8},{"lines":"17","time":36.5333},{"lines":"19","time":42.2},{"lines":"15","time":44.2},{"lines":"17","time":45.9333},{"lines":"19","time":49.4},{"lines":"15","time":51.4},{"lines":"17","time":53.1333},{"lines":"19","time":56.6},{"lines":"15","time":58.6},{"lines":"17","time":60.3333},{"lines":"19","time":63.8},{"lines":"15","time":65.8},{"lines":"17","time":67.5333},{"lines":"19","time":71.0},{"lines":"15","time":73.0},{"lines":"19","time":76.0},{"lines":"19","time":83.8}]},"python":{"code":["# the demo DAG's out-adjacency (arrows only)","adj = {0: [2, 3, 4], 1: [2, 7], 2: [5], 3: [5, 7],","       4: [7], 5: [6], 6: [7], 7: []}","","indegree = {v: 0 for v in adj}          # count arriving edges","for neighbors in adj.values():","    for v in neighbors:","        indegree[v] += 1","","queue = deque(v for v in indegree if indegree[v] == 0)","order = []","while queue:","    v = queue.popleft()                  # take a zero-indegree vertex","    order.append(v)","    for n in adj[v]:                     # removing v frees its out-edges","        indegree[n] -= 1","        if indegree[n] == 0:","            queue.append(n)"],"map":[{"lines":"2","time":0.0},{"lines":"5","time":9.0},{"lines":"8","time":10.0},{"lines":"10","time":13.2667},{"lines":"13","time":13.8},{"lines":"15","time":15.5333},{"lines":"18","time":23.4},{"lines":"13","time":25.4},{"lines":"15","time":27.1333},{"lines":"18","time":32.8},{"lines":"13","time":34.8},{"lines":"15","time":36.5333},{"lines":"18","time":42.2},{"lines":"13","time":44.2},{"lines":"15","time":45.9333},{"lines":"18","time":49.4},{"lines":"13","time":51.4},{"lines":"15","time":53.1333},{"lines":"18","time":56.6},{"lines":"13","time":58.6},{"lines":"15","time":60.3333},{"lines":"18","time":63.8},{"lines":"13","time":65.8},{"lines":"15","time":67.5333},{"lines":"18","time":71.0},{"lines":"13","time":73.0},{"lines":"18","time":76.0},{"lines":"18","time":83.8}]}},"video":"Videos/Graphs/TopologicalSort.webm"}
