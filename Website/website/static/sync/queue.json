{"default":"python","langs":{"c":{"code":["int queue[5];           /* capacity 5 in the animation */","int count = 0;          /* elements currently stored */","","/* Enqueue: insert at the rear */","int values[5] = {2, 4, 3, 5, 4};","for (int i = 0; i < 5; i++)","    queue[count++] = values[i];","","/* The queue is now full - a 6th insert overflows */","if (count == 5) {","    /* enqueue(8) -> Overflow! */","}","","/* Dequeue: remove from the front (FIFO) */","while (count > 0) {","    int front = queue[0];        /* leave from the front */","    printf(\"%d\\n\", front);","    for (int i = 1; i < count; i++)","        queue[i - 1] = queue[i]; /* slide the rest forward */","    count--;","}"],"map":[{"lines":"4-5","time":0.0},{"lines":"7","time":1.0},{"lines":"9-11","time":17.0},{"lines":"14-15","time":22.6},{"lines":"16","time":23.6},{"lines":"18-19","time":25.2},{"lines":"16","time":27.5333},{"lines":"18-19","time":29.1333},{"lines":"16","time":30.9333},{"lines":"18-19","time":32.5333},{"lines":"16","time":33.8},{"lines":"18-19","time":35.4},{"lines":"16","time":36.1333},{"lines":"16","time":37.9333}]},"cpp":{"code":["int queue[5];           // capacity 5 in the animation","int count = 0;          // elements currently stored","","// Enqueue: insert at the rear","int values[5] = {2, 4, 3, 5, 4};","for (int i = 0; i < 5; i++)","    queue[count++] = values[i];","","// The queue is now full - a 6th insert overflows","if (count == 5) {","    // enqueue(8) -> Overflow!","}","","// Dequeue: remove from the front (FIFO)","while (count > 0) {","    int front = queue[0];        // leave from the front","    std::cout << front << \"\\n\";","    for (int i = 1; i < count; i++)","        queue[i - 1] = queue[i]; // slide the rest forward","    count--;","}"],"map":[{"lines":"4-5","time":0.0},{"lines":"7","time":1.0},{"lines":"9-11","time":17.0},{"lines":"14-15","time":22.6},{"lines":"16","time":23.6},{"lines":"18-19","time":25.2},{"lines":"16","time":27.5333},{"lines":"18-19