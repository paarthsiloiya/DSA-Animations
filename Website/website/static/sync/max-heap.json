{"default":"python","langs":{"c":{"code":["/* a max-heap: every parent >= its children (array form) */","int heap[64];","int size = 0;","","/* join at the next free slot, then swap up while the child is the outlier */","void insert(int value) {","    heap[size] = value;                 /* join at the next free slot */","    size++;","    int i = size - 1;","    while (i > 0) {","        int parent = (i - 1) / 2;","        if (heap[i] > heap[parent]) {   /* child vs parent? */","            int tmp = heap[i]; heap[i] = heap[parent]; heap[parent] = tmp;","            i = parent;","        } else {","            break;                       /* heap property holds again */","        }","    }","}","/* insert 2, 7, 26, 25, 19, 17, 1, 90, 3, 36:","   the array becomes 90 36 17 25 26 7 1 2 3 19 */"],"map":[{"lines":"6","time":0.0},{"lines":"7-8","time":0.8},{"lines":"6","time":2.2667},{"lines":"7-8","time":3.0667},{"lines":"12-13","time":4.6},{"lines":"6","time":8.0667},{"lines":"7-8","time":8.8667},{"lines":"12-13","time":10.4},{"lines":"6","time":13.8667},{"lines":"7-8","time":14.6667},{"lines":"12-13","time":16.2},{"lines":"16","time":18.7333},{"lines":"6","time":21.4},{"lines":"7-8","time":22.2},{"lines":"16","time":23.8},{"lines":"6","time":26.4667},{"lines":"7-8","time":27.2667},{"lines":"12-13","time":28.8},{"lines":"16","time":31.3333},{"lines":"6","time":34.0},{"lines":"7-8","time":34.8},{"lines":"16","time":36.4},{"lines":"6","time":39.0667},{"lines":"7-8","time":39.8667},{"lines":"12-13","time":41.4},{"lines":"6","time":49.8},{"lines":"7-8","time":50.6},{"lines":"16","time":52.2},{"lines":"6","time":54.8667},{"lines":"7-8","time":55.6667},{"lines":"12-13","time":57.2},{"lines":"16","time":62.2},{"lines":"16","time":66.8667}]},"cpp":{"code":["// a max-heap: every parent >= its children (array form)","std::vector<int> heap;","","// join at the next free slot, then swap up while the child is the outlier","void insert(int value) {","    heap.push_back(value);       