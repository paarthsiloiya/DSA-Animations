{"default":"python","langs":{"c":{"code":["/* 1: [2, 4]  2: [4, 3, 5]  3: [6]  4: []  5: [6, 7]  6: [7]  7: [] */","","int s = 1;                          /* the start vertex */","","int visited[8] = {0}; visited[s] = 1;/* discovered vertices */","int stack[8]; int top = 0;          /* LIFO: newest processed first */","stack[top++] = s;","while (top > 0) {","    int current = stack[--top];      /* take the newest */","    for (int k = adj_count[current] - 1; k >= 0; k--) {  /* reversed: dive first */","        int neighbor = adjacency[current][k];","        if (!visited[neighbor]) {","            visited[neighbor] = 1;","            stack[top++] = neighbor;  /* dives deeper first */","        }","    }","}"],"map":[{"lines":"1","time":0.0},{"lines":"3","time":3.0},{"lines":"9","time":9.1333},{"lines":"12-14","time":10.0},{"lines":"9","time":16.7333},{"lines":"12-14","time":17.6},{"lines":"9","time":24.3333},{"lines":"12-14","time":25.2},{"lines":"9","time":29.5333},{"lines":"12-14","time":30.4},{"lines":"9","time":34.7333},{"lines":"9","time":54.5333}]},"cpp":{"code":["// 1: [2, 4]  2: [4, 3, 5]  3: [6]  4: []  5: [6, 7]  6: [7]  7: [] ","","int s = 1;                          // the start vertex ","","std::vector<int> visited(8, 0); visited[s] = 1; // discovered vertices ","int stack[8]; int top = 0;          // LIFO: newest processed first ","stack[top++] = s;","while (top > 0) {","    int current = stack[--top];      // take the newest ","    for (int k = adj_count[current] - 1; k >= 0; k--) {  // reversed: dive first ","        int neighbor = adjacency[current][k];","        if (!visited[neighbor]) {","            visited[neighbor] = 1;","            stack[top++] = neighbor;  // dives deeper first ","        }","    }","}"],"map":[{"lines":"1","time":0.0},{"lines":"3","time":3.0},{"lines":"9","time":9.1333},{"lines":"12-14","time":10.0},{"lines":"9","time":16.7333},{"lines":"12-14","time":17.6},{"lines":"9","time":24.3333},{"lines":"12-14","time":25.2},{"lines":