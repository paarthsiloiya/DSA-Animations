{"default":"python","langs":{"c":{"code":["/* the demo graph (undirected: every edge is stored both ways) */","int adj[7][7][2] = {{{1,10},{2,80}}, {{0,10},{2,6},{4,20}},","                     {{0,80},{1,6},{3,70}}, {{2,70}},","                     {{1,20},{5,50},{6,5}}, {{4,50},{6,10}}, {{4,5},{5,10}}};","int adj_count[7] = {2, 3, 3, 1, 3, 2, 2};","","int visited[7] = {0};               /* the tree starts at vertex 0 */","int tree[6][2];                      /* the growing tree's edges */","int total = 0;","","void prim(void) {","    visited[0] = 1;","    int tree_size = 0;","    while (tree_size < 6) {          /* V-1 growth rounds */","        int bu = -1, bv = -1, bw = -1;   /* scan every cut edge */","        for (int u = 0; u < 7; u++) {    /* visited -> unvisited */","            if (!visited[u]) continue;   /* for the minimum weight */","            for (int k = 0; k < adj_count[u]; k++) {","                int v = adj[u][k][0], w = adj[u][k][1];","                if (!visited[v] && (bw == -1 || w < bw)) {","                    bu = u; bv = v; bw = w;","                }","            }","        }","        visited[bv] = 1;             /* grow the tree by that edge */","        tree[tree_size][0] = bu; tree[tree_size][1] = bv;","        tree_size++;","        total += bw;","    }","}"],"map":[{"lines":"5","time":0.0},{"lines":"7","time":9.0},{"lines":"14","time":9.5333},{"lines":"15","time":10.0667},{"lines":"25","time":11.6667},{"lines":"28","time":13.3333},{"lines":"15","time":14.6667},{"lines":"25","time":17.0667},{"lines":"28","time":18.7333},{"lines":"15","time":20.0667},{"lines":"25","time":21.6667},{"lines":"28","time":23.3333},{"lines":"15","time":24.6667},{"lines":"25","time":27.0667},{"lines":"28","time":28.7333},{"lines":"15","time":30.0667},{"lines":"25","time":32.4667},{"lines":"28","time":34.1333},{"lines":"15","time":35.4667},{"lines":"25","time":36.2667},{"lines":"28","time":37.9333},{"lines":"28","time":47.2}]},"cpp":{"code":["// the demo graph (undirected: every edge is stored both ways) ","int adj[7][7][2] = {{{1,10},{2,80}}, {{0,10},{2,6},{4,20}},","                     {{0,80},{1,6},{3,70}}, {{2,70}},","                     {{1,20},{5,50},{6,5}}, {{4,50},{6,10}}, {{4,5},{5,10}}};","int adj_count[7] = {2, 3, 3, 1, 3, 2, 2};","","int visited[7] = {0};               // the tree starts at vertex 0 ","int tree[6][2];                      // the growing tree's edges ","int total = 0;","","void prim(void) {","    visited[0] = 1;","    int tree_size = 0;","    while (tree_size < 6) {          // V-1 growth rounds ","        int bu = -1, bv = -1, bw = -1;   // scan every cut edge ","        for (int u = 0; u < 7; u++) {    // visited -> unvisited ","            if (!visited[u]) continue;   // for the minimum weight ","            for (int k = 0; k < adj_count[u]; k++) {","                int v = adj[u][k][0], w = adj[u][k][1];","                if (!visited[v] && (bw == -1 || w < bw)) {","                    bu = u; bv = v; bw = w;","                }","            }","        }","        visited[bv] = 1;             // grow the tree by that edge ","        tree[tree_size][0] = bu; tree[tree_size][1] = bv;","        tree_size++;","        total += bw;","    }","}"],"map":[{"lines":"5","time":0.0},{"lines":"7","time":9.0},{"lines":"14","time":9.5333},{"lines":"15","time":10.0667},{"lines":"25","time":11.6667},{"lines":"28","time":13.3333},{"lines":"15","time":14.6667},{"lines":"25","time":17.0667},{"lines":"28","time":18.7333},{"lines":"15","time":20.0667},{"lines":"25","time":21.6667},{"lines":"28","time":23.3333},{"lines":"15","time":24.6667},{"lines":"25","time":27.0667},{"lines":"28","time":28.7333},{"lines":"15","time":30.0667},{"lines":"25","time":32.4667},{"lines":"28","time":34.1333},{"lines":"15","time":35.4667},{"lines":"25","time":36.2667},{"lines":"28","time":37.9333},{"lines":"28","time":47.2}]},"java":{"code":["// the demo graph (undirected: every edge is stored both ways)","int[][][] adj = { { {1,10},{2,80} }, { {0,10},{2,6},{4,20} },","                  { {0,80},{1,6},{3,70} }, { {2,70} },","                  { {1,20},{5,50},{6,5} }, { {4,50},{6,10} }, { {4,5},{5,10} } };","","boolean[] visited = new boolean[7];  // the tree starts at vertex 0","int[][] tree = new int[6][2];        // the growing tree's edges","int total = 0;","","void prim() {","    visited[0] = true;","    int treeSize = 0;","    while (treeSize < 6) {           // V-1 growth rounds","        int bu = -1, bv = -1, bw = -1;   // scan every cut edge","        for (int u = 0; u < 7; u++) {    // visited -> unvisited","            if (!visited[u]) continue;   // for the minimum weight","            for (int[] pair : adj[u]) {","                int v = pair[0], w = pair[1];","                if (!visited[v] && (bw == -1 || w < bw)) {","                    bu = u; bv = v; bw = w;","                }","            }","        }","        visited[bv] = true;          // grow the tree by that edge","        tree[treeSize][0] = bu; tree[treeSize][1] = bv;","        treeSize++;","        total += bw;","    }","}"],"map":[{"lines":"2","time":0.0},{"lines":"6","time":9.0},{"lines":"13","time":9.5333},{"lines":"14","time":10.0667},{"lines":"24","time":11.6667},{"lines":"27","time":13.3333},{"lines":"14","time":14.6667},{"lines":"24","time":17.0667},{"lines":"27","time":18.7333},{"lines":"14","time":20.0667},{"lines":"24","time":21.6667},{"lines":"27","time":23.3333},{"lines":"14","time":24.6667},{"lines":"24","time":27.0667},{"lines":"27","time":28.7333},{"lines":"14","time":30.0667},{"lines":"24","time":32.4667},{"lines":"27","time":34.1333},{"lines":"14","time":35.4667},{"lines":"24","time":36.2667},{"lines":"27","time":37.9333},{"lines":"27","time":47.2}]},"python":{"code":["# the demo graph (undirected: every edge is stored both ways)","adj = {0: [(1, 10), (2, 80)], 1: [(0, 10), (2, 6), (4, 20)],","      2: [(0, 80), (1, 6), (3, 70)], 3: [(2, 70)],","      4: [(1, 20), (5, 50), (6, 5)], 5: [(4, 50), (6, 10)],","      6: [(4, 5), (5, 10)]}","","visited = {0}                        # the tree starts at vertex 0","tree, total = [], 0","","while len(visited) < 7:             # V-1 growth rounds","    best = None                      # scan every cut edge (visited -> unvisited)","    for u in visited:                # for the minimum-weight one","        for v, w in adj[u]:","            if v not in visited and (best is None or w < best[2]):","                best = (u, v, w)","    visited.add(best[1])             # grow the tree by that edge","    tree.append(best[:2])","    total += best[2]"],"map":[{"lines":"2","time":0.0},{"lines":"7","time":9.0},{"lines":"10","time":9.5333},{"lines":"11","time":10.0667},{"lines":"16","time":11.6667},{"lines":"18","time":13.3333},{"lines":"11","time":14.6667},{"lines":"16","time":17.0667},{"lines":"18","time":18.7333},{"lines":"11","time":20.0667},{"lines":"16","time":21.6667},{"lines":"18","time":23.3333},{"lines":"11","time":24.6667},{"lines":"16","time":27.0667},{"lines":"18","time":28.7333},{"lines":"11","time":30.0667},{"lines":"16","time":32.4667},{"lines":"18","time":34.1333},{"lines":"11","time":35.4667},{"lines":"16","time":36.2667},{"lines":"18","time":37.9333},{"lines":"18","time":47.2}]}},"video":"Videos/Graphs/PrimsMCST.webm"}
