{"default":"python","langs":{"c":{"code":["/* the demo graph's out-adjacency with weights */","int adj[7][7][2] = {{{1,10},{2,80}}, {{2,6},{4,20}}, {{3,70}}, {{}},","                    {{5,50},{6,5}}, {{6,10}}, {{}}};","int adj_count[7] = {2, 2, 1, 0, 2, 1, 0};","","int start = 0;","double dist[7];                       /* tentative distances */","int visited[7] = {0};","","void dijkstra(void) {","    for (int v = 0; v < 7; v++) dist[v] = 1e18;","    dist[start] = 0;","    for (int round = 0; round < 7; round++) {","        int min_node = -1;            /* select the unvisited node with min dist */","        for (int node = 0; node < 7; node++)","            if (!visited[node] && (min_node == -1 || dist[node] < dist[min_node]))","                min_node = node;","        if (min_node == -1) return;","        visited[min_node] = 1;","        for (int k = 0; k < adj_count[min_node]; k++) {   /* relax its edges */","            int neighbor = adj[min_node][k][0];","            int weight = adj[min_node][k][1];","            if (!visited[neighbor]) {","                double new_dist = dist[min_node] + weight;","                if (new_dist < dist[neighbor])","                    dist[neighbor] = new_dist;","            }","        }","    }","}"],"map":[{"lines":"4","time":0.0},{"lines":"11","time":9.0},{"lines":"12","time":10.0},{"lines":"14","time":17.9333},{"lines":"20","time":22.8667},{"lines":"19","time":34.7333},{"lines":"14","time":37.2},{"lines":"20","time":42.1333},{"lines":"19","time":54.0},{"lines":"14","time":56.4667},{"lines":"20","time":61.4},{"lines":"19","time":67.6},{"lines":"14","time":70.0667},{"lines":"20","time":75.0},{"lines":"19","time":86.8667},{"lines":"14","time":89.3333},{"lines":"19","time":94.8},{"lines":"14","time":97.2667},{"lines":"19","time":104.1333},{"lines":"14","time":106.6},{"lines":"19","time":112.0667},{"lines":"19","time":119.7333}]},"cpp":{"code":["// the demo graph's out-adjacency with weights ","int adj[7][7][2] = {{{1,10},