st = new double[7];        // tentative distances","boolean[] visited = new boolean[7];","","void dijkstra() {","    java.util.Arrays.fill(dist, Double.POSITIVE_INFINITY);","    dist[start] = 0;","    for (int round = 0; round < 7; round++) {","        int minNode = -1;             // select the unvisited node with min dist","        for (int node = 0; node < 7; node++)","            if (!visited[node] && (minNode == -1 || dist[node] < dist[minNode]))","                minNode = node;","        if (minNode == -1) return;","        visited[minNode] = true;","        for (int[] pair : adj[minNode]) {   // relax its edges","            int neighbor = pair[0], weight = pair[1];","            if (!visited[neighbor]) {","                double newDist = dist[minNode] + weight;","                if (newDist < dist[neighbor])","                    dist[neighbor] = newDist;","            }","        }","    }","}"],"map":[{"lines":"2","time":0.0},{"lines":"10","time":9.0},{"lines":"11","time":10.0},{"lines":"13","time":17.9333},{"lines":"19","time":22.8667},{"lines":"18","time":34.7333},{"lines":"13","time":37.2},{"lines":"19","time":42.1333},{"lines":"18","time":54.0},{"lines":"13","time":56.4667},{"lines":"19","time":61.4},{"lines":"18","time":67.6},{"lines":"13","time":70.0667},{"lines":"19","time":75.0},{"lines":"18","time":86.8667},{"lines":"13","time":89.3333},{"lines":"18","time":94.8},{"lines":"13","time":97.2667},{"lines":"18","time":104.1333},{"lines":"13","time":106.6},{"lines":"18","time":112.0667},{"lines":"18","time":119.7333}]},"python":{"code":["# the demo graph: dist labels appear over every vertex","adj_list = {0: [(1, 10), (2, 80)], 1: [(2, 6), (4, 20)],","            2: [(3, 70)], 3: [], 4: [(5, 50), (6, 5)], 5: [(6, 10)], 6: []}","","start = 0","dist = {v: float('inf') for v in range(7)}   # tentative distances","dist[start] = 0","visited = set()","","while len(visited) < 7:","    # select the unvisited node with the minimum tentative distance","    min_