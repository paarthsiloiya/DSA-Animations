{"default":"python","langs":{"c":{"code":["int V[5] = {0, 1, 2, 3, 4};","int W[6][3] = {{0,1,10},{0,3,18},{1,2,20},{1,3,6},{2,4,8},{3,4,70}};","","/* V x V grid, 0 = no edge */","int M[5][5] = {0};","","void build(void) {","    for (int e = 0; e < 6; e++) {","        int u = W[e][0], v = W[e][1], w = W[e][2];","        M[u][v] = w;","        M[v][u] = w;                    /* symmetric: undirected */","    }","}","","/* M[u][v] = the weight of edge (u, v); 0 = no edge */"],"map":[{"lines":"1-2","time":0.0},{"lines":"5","time":7.0},{"lines":"7-15","time":9.7333},{"lines":"7-15","time":40.9333}]},"cpp":{"code":["int V[5] = {0, 1, 2, 3, 4};","int W[6][3] = {{0,1,10},{0,3,18},{1,2,20},{1,3,6},{2,4,8},{3,4,70}};","","// V x V grid, 0 = no edge","int M[5][5] = {0};","","void build(void) {","    for (int e = 0; e < 6; e++) {","        int u = W[e][0], v = W[e][1], w = W[e][2];","        M[u][v] = w;","        M[v][u] = w;                    // symmetric: undirected","    }","}","","// M[u][v] = the weight of edge (u, v); 0 = no edge"],"map":[{"lines":"1-2","time":0.0},{"lines":"5","time":7.0},{"lines":"7-15","time":9.7333},{"lines":"7-15","time":40.9333}]},"java":{"code":["int[] V = {0, 1, 2, 3, 4};","int[][] W = {{0,1,10},{0,3,18},{1,2,20},{1,3,6},{2,4,8},{3,4,70}};","","int[][] M = new int[5][5];        // V x V grid, 0 = no edge","","void build() {","    for (int[] e : W) {","        int u = e[0], v = e[1], w = e[2];","        M[u][v] = w;","        M[v][u] = w;                    // symmetric: undirected","    }","}","","// M[u][v] = the weight of edge (u, v); 0 = no edge"],"map":[{"lines":"1-2","time":0.0},{"lines":"4","time":7.0},{"lines":"6-14","time":9.7333},{"lines":"6-14","time":40.9333}]},"python":{"code":["V = [0, 1, 2, 3, 4]","W = [(0, 1, 10), (0, 3, 18), (1, 2, 20),","     (1, 3, 6), (2, 4, 8), (3, 4, 70)]","","M = [[0] * len(V) for _ in V]      # V x V grid, 0 = no edge","","for u, v, w in W:","    M[u][v] = w","    M[v][u] = w                    # symmetric: undirected","","# M[u][v] = the weight of edge (u, v); 0 = no edge"],"map":[{"lines":"1-2","time":0.0},{"lines":"5","time":7.0},{"lines":"7-11","time":9.7333},{"lines":"7-11","time":40.9333}]}},"video":"Videos/Graphs/WeightedAdjacencyMatrixUD.webm"}
