{"default":"python","langs":{"c":{"code":["/* Right-Right case: balance < -1, deep path goes RIGHT then RIGHT */","/* -> a single LEFT rotation restores balance */","","/* when it fires (inside insert):","   if (balance < -1 && key > root->right->key)","       return left_rotate(root);","*/","","struct Node *left_rotate(struct Node *z) {","    struct Node *y = z->right;     /* the new subtree root */","    struct Node *T2 = y->left;     /* detaches */","    y->left = z;                   /* z drops down */","    z->right = T2;                 /* z adopts T2 */","    z->height = 1 + max(height(z->left), height(z->right));","    y->height = 1 + max(height(y->left), height(y->right));","    return y;","}"],"map":[{"lines":"1-7","time":0.0},{"lines":"12-13","time":31.8},{"lines":"14-16","time":37.3333},{"lines":"14-16","time":41.3333}]},"cpp":{"code":["// Right-Right case: balance < -1, deep path goes RIGHT then RIGHT","// -> a single LEFT rotation restores balance","","// when it fires (inside insert):","//   if (balance < -1 && key > root->right->key)","//       return leftRotate(root);","","Node *left_rotate(Node *z) {","    Node *y = z->right;      // the new subtree root","    Node *T2 = y->left;      // detaches","    y->left = z;             // z drops down","    z->right = T2;           // z adopts T2","    z->height = 1 + std::max(height(z->left), height(z->right));","    y->height = 1 + std::max(height(y->left), height(y->right));","    return y;","}"],"map":[{"lines":"1-6","time":0.0},{"lines":"12-13","time":31.8},{"lines":"14-16","time":37.3333},{"lines":"14-16","time":41.3333}]},"java":{"code":["// Right-Right case: balance < -1, deep path goes RIGHT then RIGHT","// -> a single LEFT rotation restores balance","","// when it fires (inside insert):","//   if (balance < -1 && key > root.right.key)","//       return leftRotate(root);","","Node leftRotate(Node z) {","    Node y = z.right;        // the new subtree root","    Node T2 = y.left;        // detaches","    y.left = z;              // z drops down","    z.right = T2;            // z adopts T2","    z.height = 1 + Math.max(height(z.left), height(z.right));","    y.height = 1 + Math.max(height(y.left), height(y.right));","    return y;","}"],"map":[{"lines":"1-6","time":0.0},{"lines":"12-13","time":31.8},{"lines":"14-16","time":37.3333},{"lines":"14-16","time":41.3333}]},"python":{"code":["# Right-Right case: balance < -1 and the deep path goes RIGHT then RIGHT","# -> a single LEFT rotation restores balance","","# when it fires (inside insert):","#   if balance < -1 and key > root.right.key:","#       return left_rotate(root)","","def left_rotate(z):","    y = z.right             # z right child - the new subtree root","    T2 = y.left             # y left subtree detaches","    y.left = z              # z drops down to become y left child","    z.right = T2            # z adopts y old left subtree","    z.height = 1 + max(height(z.left), height(z.right))","    y.height = 1 + max(height(y.left), height(y.right))","    return y               # y is the new subtree root"],"map":[{"lines":"1-6","time":0.0},{"lines":"11-12","time":31.8},{"lines":"13-15","time":37.3333},{"lines":"13-15","time":41.3333}]}},"video":"Videos/AVLTree/RightRightCase.webm"}
