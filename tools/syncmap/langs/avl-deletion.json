            "        return left_rotate(root);",
            "    if (balance < -1 && get_balance(root->right) > 0) { /* Right-Left */",
            "        root->right = right_rotate(root->right);",
            "        return left_rotate(root);",
            "    }",
            "    return root;",
            "}"
