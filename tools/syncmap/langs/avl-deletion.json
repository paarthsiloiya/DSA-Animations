            "        root->left = delete(root->left, key);",
            "    else if (key > root->key)",
            "        root->right = delete(root->right, key);",
            "    else {                                 /* found the node */",
            "        if (root->left == NULL)           /* case: no left child */",
            "            return root->right;",
            "        if (root->right == NULL)         /* case: no right child */",
            "            return root->left;",
            "        struct Node *s = min_value_node(root->right);  /* successor */",
            "        root->key = s->key;",
            "        root->right = delete(root->right, s->key);",
            "    }",
            "",
            "    root->height = 1 + max(height(root->left), height(root->right));",
            "    int balance = height(root->left) - height(root->right);",
            "",
            "    if (balance > 1 && get_balance(root->left) >= 0)   /* Left-Left */",
            "        return right_rotate(root);",
            "    if (balance > 1 && get_balance(root->left) < 0) {  /* Left-Right */",
            "        root->left = left_rotate(root->left);",
            "        return right_rotate(root);",
            "    }",
