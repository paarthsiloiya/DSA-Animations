        "code": [
            "/* the demo: ranks given by the animation's top row */",
            "int values[6] = {4, 2, 1, 6, 3, 5};    /* F B E A D C */",
            "int temp[6];",
            "",
            "int merge(int a[], int temp[], int left, int mid, int right) {",
            "    int i = left, j = mid + 1, k = left, split = 0;",
            "    while (i <= mid && j <= right) {",
            "        if (a[i] <= a[j]) {",
            "            temp[k++] = a[i++];",
            "        } else {",
            "            split += mid - i + 1;       /* every remaining left element */",
            "            temp[k++] = a[j++];         /* is inverted with a[j] */",
            "        }",
            "    }",
            "    while (i <= mid) temp[k++] = a[i++];",
            "    while (j <= right) temp[k++] = a[j++];",
            "    for (i = left; i <= right; i++) a[i] = temp[i];",
            "    return split;",
            "}",
            "",
            "int merge_count(int a[], int temp[], int left, int right) {",
            "    if (left >= right) return 0;",
            "    int mid = (left + right) / 2;",
            "    return merge_count(a, temp, left, mid)",
            "         + merge_count(a, temp, mid + 1, right)",
            "         + merge(a, temp, left, mid, right);",
            "}",
            "",
            "/* merge_count(values, temp, 0, 5) counts 6 inversions */"
        ],
