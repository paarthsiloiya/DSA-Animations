        "code": [
            "int arr[6] = {5, 2, 4, 6, 3, 1};",
            "",
            "/* Forward indexing: positions 0 to N-1 */",
            "printf(\"%d\\n\", arr[0]);   /* 5 - first element */",
            "printf(\"%d\\n\", arr[3]);   /* 6 - fourth element */",
            "",
            "/* Reverse indexing: C has no negative indices - */",
            "/* emulate arr[-k] as arr[N - k] */",
            "printf(\"%d\\n\", arr[6 - 6]);  /* 5 - first element again */",
            "printf(\"%d\\n\", arr[6 - 1]);  /* 1 - last element */"
        ],
