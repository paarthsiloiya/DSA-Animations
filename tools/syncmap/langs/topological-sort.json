        "code": [
            "// the demo DAG's out-adjacency (arrows only)",
            "int[][] adj = { {2,3,4}, {2,7}, {5}, {5,7}, {7}, {6}, {7}, {} };",
            "",
            "int[] indegree = new int[8];         // count arriving edges",
            "Deque<Integer> queue = new ArrayDeque<>();",
            "List<Integer> order = new ArrayList<>();",
            "",
            "void topoSort() {",
            "    for (int u = 0; u < 8; u++)",
            "        for (int n : adj[u])",
            "            indegree[n]++;",
            "    for (int v = 0; v < 8; v++)",
            "        if (indegree[v] == 0) queue.add(v);",
            "    while (!queue.isEmpty()) {",
            "        int v = queue.poll();        // take a zero-indegree vertex",
            "        order.add(v);",
            "        for (int n : adj[v]) {       // frees its out-edges",
            "            if (--indegree[n] == 0)",
