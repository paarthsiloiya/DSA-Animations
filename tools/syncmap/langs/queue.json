    "c": {
        "code": [
            "int queue[5];           /* capacity 5 in the animation */",
            "int count = 0;          /* elements currently stored */",
            "",
            "/* Enqueue: insert at the rear */",
            "int values[5] = {2, 4, 3, 5, 4};",
            "for (int i = 0; i < 5; i++)",
            "    queue[count++] = values[i];",
            "",
            "/* The queue is now full - a 6th insert overflows */",
            "if (count == 5) {",
            "    /* enqueue(8) -> Overflow! */",
            "}",
            "",
            "/* Dequeue: remove from the front (FIFO) */",
            "while (count > 0) {",
            "    int front = queue[0];        /* leave from the front */",
            "    printf(\"%d\\n\", front);",
            "    for (int i = 1; i < count; i++)",
            "        queue[i - 1] = queue[i]; /* slide the rest forward */",
            "    count--;",
            "}"
        ],
        "steps": {
            "enqueue": "4-5",
            "insert": "7",
            "overflow": "9-11",
            "dequeue": "14-15",
