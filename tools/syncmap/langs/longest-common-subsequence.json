            "void fillTable() {",
            "    for (int j = n - 1; j >= 0; j--)            // columns right to left",
            "        for (int i = m - 1; i >= 0; i--) {      // rows bottom to top",
            "            if (u.charAt(i) == v.charAt(j))",
            "                lcs[i][j] = lcs[i + 1][j + 1] + 1;",
            "            else",
            "                lcs[i][j] = Math.max(lcs[i + 1][j], lcs[i][j + 1]);",
            "        }",
            "}",
