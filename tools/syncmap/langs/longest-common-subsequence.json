            "    while (i > 0 && j > 0) {",
            "        if (u.charAt(i - 1) == v.charAt(j - 1)) {",
            "            sb.insert(0, u.charAt(i - 1));",
            "            i--; j--;",
            "        }",
            "        else if (lcs[i - 1][j] > lcs[i][j - 1]) i--;",
            "        else j--;",
            "    }",
