            "/* demo strings (equal length here; the algorithm works for any pair) */",
            "char u[] = \"bisect\", v[] = \"secret\";",
            "int m = 6, n = 6;",
            "int lcs[7][7];    /* lcs[i][j] = LCS length of u[i:] and v[j:] */",
            "",
            "void fill_table(void) {",
            "    for (int j = n - 1; j >= 0; j--)            /* columns right to left */",
            "        for (int i = m - 1; i >= 0; i--) {      /* rows bottom to top */",
            "            if (u[i] == v[j])",
            "                lcs[i][j] = lcs[i + 1][j + 1] + 1;",
            "            else {",
            "                int a = lcs[i + 1][j], b = lcs[i][j + 1];",
            "                lcs[i][j] = a >= b ? a : b;",
            "            }",
            "        }",
            "}",
            "",
            "/* walk the filled table backwards to recover the string */",
            "void recover(char out[]) {",
            "    int i = m, j = n, k = lcs[0][0] - 1;",
            "    while (i > 0 && j > 0) {",
            "        if (u[i - 1] == v[j - 1]) {",
            "            out[k--] = u[i - 1];",
            "            i--; j--;",
            "        }",
            "        else if (lcs[i - 1][j] > lcs[i][j - 1]) i--;",
            "        else j--;",
            "    }",
            "    out[lcs[0][0]] = '\\0';",
            "}",
            "",
            "/* the answer: lcs[0][0] == 4 and the string is \"sect\" */"
