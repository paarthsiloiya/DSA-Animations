            "# the demo graph: dist labels appear over every vertex",
            "adj_list = {0: [(1, 10), (2, 80)], 1: [(2, 6), (4, 20)],",
            "            2: [(3, 70)], 3: [], 4: [(5, 50), (6, 5)], 5: [(6, 10)], 6: []}",
