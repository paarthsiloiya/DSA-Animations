            "    size++;",
            "    int i = size - 1;",
            "    while (i > 0) {",
            "        int parent = (i - 1) / 2;",
            "        if (heap[i] > heap[parent]) {   /* child vs parent? */",
            "            int tmp = heap[i]; heap[i] = heap[parent]; heap[parent] = tmp;",
            "            i = parent;",
            "        } else {",
            "            break;                       /* heap property holds again */",
