            "class UnionFind {",
            "    int[] parent;",
            "    int[] rank;",
            "",
            "    UnionFind(int size) {",
            "        parent = new int[size];          // each element starts alone",
            "        rank = new int[size];",
            "        for (int i = 0; i < size; i++) parent[i] = i;",
            "    }",
            "",
            "    int find(int x) {",
            "        if (parent[x] != x)",
            "            parent[x] = find(parent[x]);   // path compression",
            "        return parent[x];",
            "    }",
            "",
            "    boolean unionSets(int x, int y) {",
            "        int rootX = find(x);",
            "        int rootY = find(y);",
            "        if (rootX == rootY)",
            "            return false;                 // already the same set",
            "        if (rank[rootX] < rank[rootY])",
            "            parent[rootX] = rootY;",
            "        else if (rank[rootX] > rank[rootY])",
            "            parent[rootY] = rootX;",
            "        else {",
            "            parent[rootY] = rootX;",
            "            rank[rootX] += 1;             // union by rank",
            "        }",
            "        return true;",
            "    }",
            "}"
