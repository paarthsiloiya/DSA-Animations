    "c": {
        "code": [
            "/* demo intervals: (id, start, finish) */",
            "int starts[9] = {1, 3, 1, 4, 2, 5, 7, 10, 9};",
            "int fins[9]   = {2, 6, 5, 7, 5, 8, 10, 13, 12};",
            "int order[9];      /* ids sorted by finish time */",
            "",
            "int cmp_order(const void *a, const void *b) {",
            "    int x = *(const int *)a, y = *(const int *)b;",
            "    if (fins[x] != fins[y]) return fins[x] < fins[y] ? -1 : 1;",
            "    return x < y ? -1 : x > y;     /* stable: lower id first on ties */",
            "}",
            "",
            "void sort_by_finish(void) {",
            "    for (int k = 0; k < 9; k++) order[k] = k;",
            "    qsort(order, 9, sizeof(int), cmp_order);",
            "}",
            "",
            "int accepted[9];    /* ids of the chosen intervals */",
            "int n_accepted = 0;",
            "",
            "void greedy(void) {",
            "    accepted[n_accepted++] = order[0];   /* earliest finish is always safe */",
            "    int last_finish = fins[order[0]];",
            "    for (int k = 1; k < 9; k++) {        /* scan earliest finish first */",
            "        int id = order[k];",
            "        if (starts[id] >= last_finish) { /* fits after the last accepted? */",
            "            accepted[n_accepted++] = id; /* take it */",
            "            last_finish = fins[id];",
            "        }                                /* else: overlaps - skip it */",
            "    }",
            "}",
            "",
            "/* result: ids 0, 4, 5, 8 (4 intervals of 9) */"
        ],
