        "code": [
            "/* the demo graph (undirected: every edge is stored both ways) */",
            "int adj[7][7][2] = {{{1,10},{2,80}}, {{0,10},{2,6},{4,20}},",
            "                     {{0,80},{1,6},{3,70}}, {{2,70}},",
            "                     {{1,20},{5,50},{6,5}}, {{4,50},{6,10}}, {{4,5},{5,10}}};",
            "int adj_count[7] = {2, 3, 3, 1, 3, 2, 2};",
            "",
            "int visited[7] = {0};               /* the tree starts at vertex 0 */",
            "int tree[6][2];                      /* the growing tree's edges */",
            "int total = 0;",
            "",
            "void prim(void) {",
            "    visited[0] = 1;",
            "    int tree_size = 0;",
            "    while (tree_size < 6) {          /* V-1 growth rounds */",
            "        int bu = -1, bv = -1, bw = -1;   /* scan every cut edge */",
            "        for (int u = 0; u < 7; u++) {    /* visited -> unvisited */",
            "            if (!visited[u]) continue;   /* for the minimum weight */",
            "            for (int k = 0; k < adj_count[u]; k++) {",
            "                int v = adj[u][k][0], w = adj[u][k][1];",
            "                if (!visited[v] && (bw == -1 || w < bw)) {",
            "                    bu = u; bv = v; bw = w;",
            "                }",
            "            }",
            "        }",
            "        visited[bv] = 1;             /* grow the tree by that edge */",
            "        tree[tree_size][0] = bu; tree[tree_size][1] = bv;",
            "        tree_size++;",
            "        total += bw;",
            "    }",
            "}"
